---
import Icon from './Icon.astro';

interface Props {
  faqs: { q: string; a: string }[];
  heading?: string;
  id?: string;
}
const { faqs, heading = 'Frequently asked questions', id = 'faq' } = Astro.props;
---
<section class="py-14 md:py-18 bg-cream-deep" id={id}>
  <div class="container-narrow">
    <p class="eyebrow mb-3">Questions</p>
    <h2 class="display text-navy-900 text-3xl md:text-[2.5rem]">{heading}</h2>
    <div class="mt-8 space-y-3">
      {faqs.map((f, i) => (
        <details class="card overflow-hidden reveal" data-delay={i * 50} open={i === 0}>
          <summary class="flex items-center justify-between gap-4 p-5 font-display font-bold text-navy-900 text-[1.05rem]">
            {f.q}
            <Icon name="chevron" size={20} class="acc-chevron text-brass-500 shrink-0" />
          </summary>
          <div class="px-5 pb-5 -mt-1 text-muted leading-relaxed">{f.a}</div>
        </details>
      ))}
    </div>
  </div>
</section>
