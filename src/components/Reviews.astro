---
import Icon from './Icon.astro';
import ReviewCard from './ReviewCard.astro';
import { reviews, hasReviews, averageRating } from '@/data/reviews';
import { business } from '@/data/business';

interface Props {
  limit?: number;
  /** Hide the whole section until there are real reviews to show (homepage).
   *  The Worker reveals it when it injects live Google reviews. */
  optional?: boolean;
  /** Live reviews roll sideways in a strip instead of a grid (homepage). */
  marquee?: boolean;
}
const { limit = 6, optional = false, marquee = false } = Astro.props;
// Everything inside [data-live-reviews] is the static fallback. When the
// Google Business Profile connection is configured, worker/gbp.js
// replaces it at the edge with every live review, server-side.
const shown = reviews.slice(0, limit);
const fmt = (d: string) =>
  new Date(d + 'T12:00:00').toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
---
<section class="py-16 md:py-20 bg-cream" hidden={optional && !hasReviews} data-live-reviews-section={optional ? "" : undefined}>
  <div class="container-x">
    <div class="max-w-2xl">
      <p class="eyebrow mb-3">Reviews</p>
      <h2 class="display text-navy-900 text-3xl md:text-[2.6rem]">
        What Brooklyn and Staten Island say
      </h2>
    </div>

    <div data-live-reviews data-limit={limit} data-style={marquee ? 'marquee' : 'grid'}>
      {hasReviews && averageRating !== null && (
        <p class="mt-3 flex items-center gap-2 text-muted">
          <span class="flex text-brass-400" aria-hidden="true">
            {[1, 2, 3, 4, 5].map(() => <Icon name="star" size={18} class="fill-current" />)}
          </span>
          <strong class="text-navy-900">{averageRating}</strong>
            out of 5 on Google
        </p>
      )}

    {hasReviews ? (
      marquee && shown.length >= 3 ? (
        <>
        {/* Same markup worker/gbp.js writes for live reviews; CSS in global.css.
            The second copy makes the loop seamless and is hidden from readers. */}
        <div class="rv-marquee" style={`--rv-dur:${shown.length * 9}s`}>
          <ul class="rv-track" aria-label="Google reviews">
            {[false, true].map((copy) => shown.map((r) => (
              <li aria-hidden={copy ? 'true' : undefined} inert={copy}>
                <ReviewCard review={r} clamp copy={copy} />
              </li>
            )))}
          </ul>
        </div>
        <div class="mt-8"><a href="/reviews/" class="btn btn-outline">Read every review</a></div>
        </>
      ) : (
      <div class="mt-9 grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        {shown.map((r) => (
          <ReviewCard review={r} />
        ))}
      </div>
      )
    ) : (
      <div class="mt-9 card p-8 md:p-10 text-center max-w-2xl mx-auto">
        <span class="inline-grid place-items-center w-14 h-14 rounded-full bg-brass-50 text-brass-500 mb-4">
          <Icon name="star" size={26} />
        </span>
        <h3 class="text-xl text-navy-900">Five stars, and nothing invented</h3>
          <p class="mt-3 text-muted leading-relaxed">
            We're rated five out of five by the people who have actually called us. You won't
            find made-up testimonials on this page — only real ones, and only once they're
            real.
          </p>
          <div class="mt-7 flex justify-center">
            <a href={`tel:${business.phoneHref}`} class="btn btn-brass">
              <Icon name="phone" size={18} />
              {business.phoneDisplay}
            </a>
          </div>
        </div>
    )}
    </div>
  </div>
</section>
