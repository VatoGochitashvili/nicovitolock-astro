---
import Icon from './Icon.astro';
import { reviews, hasReviews, averageRating } from '@/data/reviews';
import { business } from '@/data/business';

interface Props { limit?: number; }
const { limit = 6 } = Astro.props;
const shown = reviews.slice(0, limit);
const fmt = (d: string) =>
  new Date(d + 'T12:00:00').toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
---
<section class="py-16 md:py-20 bg-cream">
  <div class="container-x">
    <div class="max-w-2xl">
      <p class="eyebrow mb-3">Reviews</p>
      <h2 class="display text-navy-900 text-3xl md:text-[2.6rem]">
        What Brooklyn and Staten Island say
      </h2>
      {hasReviews && averageRating !== null && (
        <p class="mt-3 flex items-center gap-2 text-muted">
          <span class="flex text-brass-400" aria-hidden="true">
            {[1, 2, 3, 4, 5].map(() => <Icon name="star" size={18} class="fill-current" />)}
          </span>
          <strong class="text-navy-900">{averageRating}</strong>
          out of 5 · {reviews.length} review{reviews.length === 1 ? '' : 's'}
        </p>
      )}
    </div>

    {hasReviews ? (
      <div class="mt-9 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {shown.map((r, i) => (
          <figure class="card p-6 flex flex-col reveal" data-delay={i * 60}>
            <div class="flex text-brass-400" aria-label={`${r.rating} out of 5 stars`}>
              {Array.from({ length: r.rating }).map(() => (
                <Icon name="star" size={17} class="fill-current" />
              ))}
            </div>
            <blockquote class="mt-3 text-navy-800 leading-relaxed grow">"{r.text}"</blockquote>
            <figcaption class="mt-4 pt-4 border-t border-line text-sm">
              <span class="font-bold text-navy-900">{r.author}</span>
              <span class="block text-muted">
                {[r.service, r.area].filter(Boolean).join(' · ')}
                {r.date && ` · ${fmt(r.date)}`}
              </span>
            </figcaption>
          </figure>
        ))}
      </div>
    ) : (
      <div class="mt-9 card p-8 md:p-10 text-center max-w-2xl mx-auto">
        <span class="inline-grid place-items-center w-14 h-14 rounded-full bg-brass-50 text-brass-500 mb-4">
          <Icon name="star" size={26} />
        </span>
        <h3 class="text-xl text-navy-900">We'd rather earn reviews than write them</h3>
        <p class="mt-3 text-muted leading-relaxed">
          You won't find invented testimonials on this page. If we've done work for you
          anywhere in Brooklyn or Staten Island, a review on our Google profile genuinely
          helps a neighborhood shop like ours — and it's the only kind we'll ever put here.
        </p>
        <a href={`tel:${business.phoneHref}`} class="btn btn-navy mt-6">
          <Icon name="phone" size={18} />
          {business.phoneDisplay}
        </a>
      </div>
    )}
  </div>
</section>
