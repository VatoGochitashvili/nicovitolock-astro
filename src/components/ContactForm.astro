---
import Icon from './Icon.astro';
import { business } from '@/data/business';
import { services } from '@/data/services';
import { serviceAreas } from '@/data/locations';

interface Props {
  /** Preselect a service (used on service pages) */
  service?: string;
  /** Preselect an area */
  area?: string;
  /** Hide the heading/intro (sidebar use) */
  compact?: boolean;
  /**
   * 'full'  — every field (contact page)
   * 'short' — name, phone, service only. Fewer fields converts better in a
   *           hero, where the visitor has not committed to anything yet.
   */
  variant?: 'full' | 'short';
  /** Dark card for placing on a light surface */
  tone?: 'light' | 'dark';
  class?: string;
}
const {
  service = '',
  area = '',
  compact = false,
  variant = 'full',
  tone = 'light',
  class: className = '',
} = Astro.props;

const short = variant === 'short';

// Unique per instance so two forms can coexist on one page. Derived from the
// props rather than randomised, so the markup stays byte-stable across builds.
const uid =
  [variant, service, area]
    .filter(Boolean)
    .join('-')
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '') || 'main';

const brooklyn = serviceAreas.filter((a) => a.region === 'Brooklyn');
const statenIsland = serviceAreas.filter((a) => a.region === 'Staten Island');

const field =
  'w-full rounded-lg border border-line bg-white px-3.5 py-2.5 text-navy-900 placeholder:text-muted/60 focus:border-brass-400 focus:ring-2 focus:ring-brass-400/30 outline-none transition';
const label = 'block text-sm font-bold text-navy-900 mb-1.5';
---
<form
  data-quote-form
  id={`quote-form-${uid}`}
  class:list={[
    tone === 'dark' ? 'bg-white rounded-xl p-6 md:p-7 shadow-2xl' : 'card p-6 md:p-8',
    className,
  ]}
  method="POST"
  action="/api/contact"
  novalidate
>
  {!compact && !short && (
    <>
      <h2 class="display text-navy-900 text-2xl">Request a quote or callback</h2>
      <p class="mt-2 text-muted text-[0.95rem]">
        Locked out right now? <a href={`tel:${business.phoneHref}`} class="link-brass">Call {business.phoneDisplay}</a> —
        a phone call is always faster than a form.
      </p>
    </>
  )}

  {short && (
    <>
      <h2 class="display text-navy-900 text-[1.45rem] leading-tight">Get a price in 2 minutes</h2>
      <p class="mt-1.5 text-muted text-[0.9rem]">
        Tell us what you need and we'll call you straight back — usually within minutes.
      </p>
    </>
  )}

  <div class:list={['grid gap-4', short ? 'mt-5' : 'mt-6 sm:grid-cols-2']}>
    <div>
      <label for={`qf-name-${uid}`} class={label}>
        Name <span class="text-brick-500">*</span>
      </label>
      <input
        id={`qf-name-${uid}`} name="name" type="text" required autocomplete="name"
        class={field} placeholder="Your name"
      />
    </div>

    <div>
      <label for={`qf-phone-${uid}`} class={label}>
        Phone <span class="text-brick-500">*</span>
      </label>
      <input
        id={`qf-phone-${uid}`} name="phone" type="tel" required autocomplete="tel"
        class={field} placeholder="(347) 000-0000"
      />
    </div>

    {!short && (
      <div class="sm:col-span-2">
        <label for={`qf-email-${uid}`} class={label}>Email</label>
        <input
          id={`qf-email-${uid}`} name="email" type="email" autocomplete="email"
          class={field} placeholder="you@example.com (optional)"
        />
      </div>
    )}

    <div>
      <label for={`qf-service-${uid}`} class={label}>What do you need?</label>
      <select id={`qf-service-${uid}`} name="service" class={field}>
        <option value="">Select a service…</option>
        {services.map((s) => (
          <option value={s.name} selected={s.slug === service || s.name === service}>{s.name}</option>
        ))}
        <option value="Something else">Something else</option>
      </select>
    </div>

    <div>
      <label for={`qf-area-${uid}`} class={label}>Where are you?</label>
      <select id={`qf-area-${uid}`} name="area" class={field}>
        <option value="">Select your neighborhood…</option>
        <optgroup label="Brooklyn">
          {brooklyn.map((a) => (
            <option value={`${a.name}, Brooklyn`} selected={a.slug === area || a.name === area}>{a.name}</option>
          ))}
        </optgroup>
        <optgroup label="Staten Island">
          {statenIsland.map((a) => (
            <option value={`${a.name}, Staten Island`} selected={a.slug === area || a.name === area}>{a.name}</option>
          ))}
        </optgroup>
      </select>
    </div>

    {!short && (
      <div class="sm:col-span-2">
        <label for={`qf-message-${uid}`} class={label}>Details</label>
        <textarea
          id={`qf-message-${uid}`} name="message" rows="4"
          class:list={[field, 'resize-y']}
          placeholder="Tell us about the door, the lock, or the car — the more detail, the more accurate the price."
        ></textarea>
      </div>
    )}
  </div>

  <!-- honeypot: bots fill this, humans never see it -->
  <div class="hidden" aria-hidden="true">
    <label for={`qf-company-${uid}`}>Company</label>
    <input id={`qf-company-${uid}`} name="company" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <button type="submit" class="btn btn-brass w-full mt-5" data-qf-submit>
    <Icon name="arrow" size={18} />
    {short ? 'Get my price' : 'Send request'}
  </button>

  {short ? (
    <p class="mt-3 text-center text-[0.82rem] text-muted">
      Or call now —
      <a href={`tel:${business.phoneHref}`} class="link-brass" data-call-cta="hero-form">
        {business.phoneDisplay}
      </a>
    </p>
  ) : (
    <p class="mt-3 text-xs text-muted text-center">
      We reply during business hours — every day, 7 AM to 11 PM. For anything urgent, call.
    </p>
  )}

  <div data-qf-status class="mt-4 hidden rounded-lg px-4 py-3 text-sm" role="status" aria-live="polite"></div>
</form>

<script is:inline define:vars={{ phone: business.phoneDisplay, phoneHref: business.phoneHref, email: business.email }}>
  (function () {
    // Bind EVERY form on the page, not a single hardcoded id — the homepage
    // hero and a sidebar form can both be present.
    function initForms() {
      var forms = document.querySelectorAll('form[data-quote-form]');
      for (var i = 0; i < forms.length; i++) bindForm(forms[i]);
    }

    function bindForm(form) {
      if (form.dataset.bound) return;
      form.dataset.bound = '1';

      var status = form.querySelector('[data-qf-status]');
      var submit = form.querySelector('[data-qf-submit]');
      var submitLabel = submit ? submit.innerHTML : '';

      function show(kind, html) {
        status.className =
          'mt-4 rounded-lg px-4 py-3 text-sm ' +
          (kind === 'ok'
            ? 'bg-green-50 text-green-900 border border-green-200'
            : 'bg-amber-50 text-amber-900 border border-amber-200');
        status.innerHTML = html;
        status.classList.remove('hidden');
      }

      form.addEventListener('submit', function (e) {
        e.preventDefault();
        if (form.company && form.company.value) return; // honeypot tripped

        var name = form.name.value.trim();
        var tel = form.phone.value.trim();
        if (!name || !tel) {
          show('warn', 'Please add your name and a phone number so we can call you back.');
          return;
        }

        submit.disabled = true;
        submit.textContent = 'Sending…';

        fetch(form.action, { method: 'POST', body: new FormData(form) })
          .then(function (r) {
            return r.ok ? r.json().catch(function () { return { ok: true }; }) : Promise.reject(r);
          })
          .then(function () {
            form.reset();
            show('ok', "<strong>Got it.</strong> We'll call you back shortly. If it's urgent, ring <a class='underline font-semibold' href='tel:" + phoneHref + "'>" + phone + '</a>.');
          })
          .catch(function () {
            // No mail backend wired yet (or a network failure) — never lose the lead.
            var body = encodeURIComponent(
              'Name: ' + name +
              '\nPhone: ' + tel +
              '\nEmail: ' + ((form.email && form.email.value) || '—') +
              '\nService: ' + ((form.service && form.service.value) || '—') +
              '\nArea: ' + ((form.area && form.area.value) || '—') +
              '\n\n' + ((form.message && form.message.value) || '')
            );
            show(
              'warn',
              "Our form couldn't send just now. Please call <a class='underline font-semibold' href='tel:" + phoneHref + "'>" + phone +
                "</a> or <a class='underline font-semibold' href='mailto:" + email + '?subject=' +
                encodeURIComponent('Locksmith request from ' + name) + '&body=' + body +
                "'>email us directly</a> — your details are already filled in."
            );
          })
          .finally(function () {
            submit.disabled = false;
            submit.innerHTML = submitLabel;
          });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initForms);
    } else {
      initForms();
    }
    document.addEventListener('astro:page-load', initForms);
  })();
</script>
