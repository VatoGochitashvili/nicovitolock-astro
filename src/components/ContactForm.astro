---
import Icon from './Icon.astro';
import { business } from '@/data/business';
import { services } from '@/data/services';
import { serviceAreas } from '@/data/locations';

interface Props {
  service?: string;
  area?: string;
  compact?: boolean;
  /** 'full' = every field (contact page). 'short' = quick capture. */
  variant?: 'full' | 'short';
  tone?: 'light' | 'dark';
  /** Drop the Call / Text row and the phone line under it. Used where the
   *  surrounding layout already puts a phone button beside the form — the
   *  homepage hero does — so the card is not repeating a CTA that sits a few
   *  inches to its left, and the whole form fits a laptop viewport. */
  hideContactRow?: boolean;
  class?: string;
}
const {
  service = '',
  area = '',
  compact = false,
  variant = 'full',
  tone = 'light',
  hideContactRow = false,
  class: className = '',
} = Astro.props;

const short = variant === 'short';

// Unique per instance so two forms can coexist on one page; derived from props
// rather than randomised so the markup stays byte-stable across builds.
const uid =
  [variant, service, area].filter(Boolean).join('-').toLowerCase()
    .replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') || 'main';

const brooklyn = serviceAreas.filter((a) => a.region === 'Brooklyn');
const statenIsland = serviceAreas.filter((a) => a.region === 'Staten Island');

// The six people actually pick in a hurry; the rest stay in the full list.
const quickPicks = [
  'emergency-lockout-service',
  'car-key-replacement',
  'lock-rekeying',
  'lock-replacement-and-repair',
  'key-fob-and-remote-programming',
  'security-camera-installation',
].map((slug) => services.find((s) => s.slug === slug)!).filter(Boolean);

const field =
  'w-full rounded-lg border border-line bg-white px-3.5 py-3 text-navy-900 placeholder:text-muted/60 focus:border-brass-400 focus:ring-4 focus:ring-brass-400/20 outline-none transition';
const label = 'block text-[0.78rem] font-bold uppercase tracking-[0.1em] text-muted mb-2';
---
<form
  data-quote-form
  id={`quote-form-${uid}`}
  class:list={[
    'relative overflow-hidden',
    tone === 'dark'
      ? 'bg-white rounded-2xl shadow-[0_30px_60px_-25px_rgba(16,35,48,0.55)]'
      : 'bg-white rounded-2xl border border-line',
    className,
  ]}
  method="POST"
  action="/api/contact"
  novalidate
>
  <!-- brass cap -->
  <div class="h-1.5 bg-gradient-to-r from-brass-400 via-brass-300 to-brass-500"></div>

  <div class="p-5" data-qf-body>
    {!compact && !short && (
      <>
        <h2 class="display text-navy-900 text-2xl">Request a quote or callback</h2>
        <p class="mt-2 text-muted text-[0.95rem]">
          Locked out right now? <a href={`tel:${business.phoneHref}`} class="link-brass">Call {business.phoneDisplay}</a> —
          a phone call is always faster than a form.
        </p>
      </>
    )}

    {short && (
      <div class="flex items-start justify-between gap-4">
        <div>
          <h2 class="display text-navy-900 text-[1.3rem] leading-tight">Get a price in 2 minutes</h2>
          <p class="mt-0.5 text-muted text-[0.86rem]">No obligation. We call you straight back.</p>
        </div>
        <!-- Static markup is the always-true statement of the hours. JS
             upgrades it to a live status in New York time; if JS never runs
             the badge is still correct, just not live. It used to say
             "Open now" unconditionally, which was a lie at 3 AM. -->
        <span
          data-hours-badge
          class="hidden sm:flex items-center gap-1.5 shrink-0 rounded-full bg-cream border border-line px-2.5 py-1 text-[0.72rem] font-bold text-navy-700"
        >
          <span data-hours-dot class="w-1.5 h-1.5 rounded-full bg-brass-400"></span>
          <span data-hours-text>7am–11pm daily</span>
        </span>
      </div>
    )}

    <!-- Step 1 — what -->
    <fieldset class="mt-3.5">
      <legend class={label}>
        <span class="text-brass-600">01</span> &nbsp;What do you need?
      </legend>
      <div class="flex flex-wrap gap-1.5" data-qf-chips>
        {quickPicks.map((s) => (
          <button
            type="button"
            data-qf-chip={s.name}
            class="inline-flex items-center gap-1.5 rounded-full border border-line bg-cream px-2.5 py-1 text-[0.82rem] font-semibold text-navy-800 hover:border-navy-300 transition-colors"
            aria-pressed="false"
          >
            <Icon name={s.icon} size={14} class="text-brass-600" />
            {s.short}
          </button>
        ))}
      </div>
      <label for={`qf-service-${uid}`} class="sr-only">Service</label>
      <select id={`qf-service-${uid}`} name="service" class:list={[field, 'mt-2.5']} data-qf-service>
        <option value="">Something else / full list…</option>
        {services.map((s) => (
          <option value={s.name} selected={s.slug === service || s.name === service}>{s.name}</option>
        ))}
      </select>
    </fieldset>

    <!-- Step 2 — where, with a live arrival estimate -->
    <fieldset class="mt-3.5">
      <legend class={label}>
        <span class="text-brass-600">02</span> &nbsp;Where are you?
      </legend>
      <label for={`qf-area-${uid}`} class="sr-only">Neighborhood</label>
      <select id={`qf-area-${uid}`} name="area" class={field} data-qf-area>
        <option value="">Select your neighborhood…</option>
        <optgroup label="Brooklyn">
          {brooklyn.map((a) => (
            <option value={`${a.name}, Brooklyn`} data-eta={a.eta} selected={a.slug === area || a.name === area}>{a.name}</option>
          ))}
        </optgroup>
        <optgroup label="Staten Island">
          {statenIsland.map((a) => (
            <option value={`${a.name}, Staten Island`} data-eta={a.eta} selected={a.slug === area || a.name === area}>{a.name}</option>
          ))}
        </optgroup>
      </select>

      <!-- Populated from the selected option's data-eta. Real numbers from
           src/data/locations.ts, not a marketing promise. -->
      <p
        data-qf-eta
        class="hidden mt-2.5 items-center gap-2 rounded-lg bg-brass-50 border border-brass-200 px-3 py-2 text-[0.85rem] text-navy-800"
      >
        <Icon name="bolt" size={15} class="text-brass-600 shrink-0" />
        <span data-qf-eta-text></span>
      </p>
    </fieldset>

    <!-- Step 3 — who -->
    <fieldset class="mt-3.5">
      <legend class={label}>
        <span class="text-brass-600">03</span> &nbsp;Where do we call you?
      </legend>
      <div class="grid sm:grid-cols-2 gap-3">
        <div>
          <label for={`qf-name-${uid}`} class="sr-only">Name</label>
          <input id={`qf-name-${uid}`} name="name" type="text" required autocomplete="name" class={field} placeholder="Your name" />
        </div>
        <div>
          <label for={`qf-phone-${uid}`} class="sr-only">Phone</label>
          <input id={`qf-phone-${uid}`} name="phone" type="tel" required autocomplete="tel" class={field} placeholder="Phone number" />
        </div>
      </div>

      {!short && (
        <>
          <label for={`qf-email-${uid}`} class="sr-only">Email</label>
          <input id={`qf-email-${uid}`} name="email" type="email" autocomplete="email" class:list={[field, 'mt-3']} placeholder="Email (optional)" />
          <label for={`qf-message-${uid}`} class="sr-only">Details</label>
          <textarea
            id={`qf-message-${uid}`} name="message" rows="4" class:list={[field, 'mt-3 resize-y']}
            placeholder="Tell us about the door, the lock, or the car — the more detail, the more accurate the price."
          ></textarea>
        </>
      )}
    </fieldset>

    <!-- honeypot -->
    <div class="hidden" aria-hidden="true">
      <label for={`qf-company-${uid}`}>Company</label>
      <input id={`qf-company-${uid}`} name="company" type="text" tabindex="-1" autocomplete="off" />
    </div>

    <button type="submit" class="btn btn-brass w-full mt-4 !py-2.5 text-[1rem]" data-qf-submit>
      {short ? 'Get my price' : 'Send request'}
      <Icon name="arrow" size={18} />
    </button>

    <p class="mt-2.5 flex items-center justify-center gap-4 text-[0.78rem] text-muted">
      <span class="flex items-center gap-1"><Icon name="badge" size={13} class="text-brass-600" /> Licensed &amp; insured</span>
      <span class="flex items-center gap-1"><Icon name="clock" size={13} class="text-brass-600" /> 7am–11pm daily</span>
    </p>

    {!hideContactRow && (
      <>
        <div class="mt-3 pt-3 border-t border-line grid grid-cols-2 gap-2.5">
          <a href={`tel:${business.phoneHref}`} class="btn btn-outline btn-sm" data-call-cta="form-inline">
            <Icon name="phone" size={15} />
            Call
          </a>
          <a href={business.smsHref} class="btn btn-outline btn-sm" data-cta="sms">
            <Icon name="mail" size={15} />
            Text us
          </a>
        </div>
        <p class="mt-2 text-center text-[0.8rem] text-muted">
          {business.phoneDisplay} · answered 7 AM – 11 PM, every day
        </p>
      </>
    )}

    <div data-qf-status class="mt-4 hidden rounded-lg px-4 py-3 text-sm" role="status" aria-live="polite"></div>
  </div>
</form>

<script is:inline>
  // Live open/closed badge. The shop runs 7 AM - 11 PM New York time, every
  // day, and is explicitly NOT 24/7 — so the badge has to be computed in that
  // timezone rather than the visitor's, or someone in London sees "Open now"
  // at 4 AM Brooklyn time and calls a phone nobody is holding.
  (function () {
    function nyHour() {
      try {
        const parts = new Intl.DateTimeFormat('en-US', {
          timeZone: 'America/New_York',
          hour: 'numeric',
          hour12: false,
        }).formatToParts(new Date());
        const h = parts.find((p) => p.type === 'hour');
        // 'en-US' with hour12:false can render midnight as 24.
        return h ? Number(h.value) % 24 : null;
      } catch (e) {
        return null;
      }
    }

    function paint() {
      const h = nyHour();
      if (h === null) return; // leave the static "7am-11pm daily" in place
      const open = h >= 7 && h < 23;
      document.querySelectorAll('[data-hours-badge]').forEach(function (b) {
        const dot = b.querySelector('[data-hours-dot]');
        const txt = b.querySelector('[data-hours-text]');
        if (!dot || !txt) return;
        b.classList.remove('bg-cream', 'border-line', 'text-navy-700');
        if (open) {
          b.classList.add('bg-green-50', 'border-green-200', 'text-green-800');
          dot.className = 'w-1.5 h-1.5 rounded-full bg-green-500';
          txt.textContent = 'Open now';
        } else {
          b.classList.add('bg-navy-50', 'border-line', 'text-navy-700');
          dot.className = 'w-1.5 h-1.5 rounded-full bg-navy-300';
          txt.textContent = h < 7 ? 'Opens 7 AM' : 'Closed · opens 7 AM';
        }
      });
    }

    paint();
    // Re-check on the hour so a page left open overnight does not keep
    // claiming the shop is open.
    setInterval(paint, 60000);
    document.addEventListener('visibilitychange', function () {
      if (!document.hidden) paint();
    });
  })();
</script>

<script is:inline define:vars={{ phone: business.phoneDisplay, phoneHref: business.phoneHref, email: business.email }}>
  (function () {
    function initForms() {
      document.querySelectorAll('form[data-quote-form]').forEach(bindForm);
    }

    function bindForm(form) {
      if (form.dataset.bound) return;
      form.dataset.bound = '1';

      var status = form.querySelector('[data-qf-status]');
      var submit = form.querySelector('[data-qf-submit]');
      var submitLabel = submit ? submit.innerHTML : '';
      var serviceSel = form.querySelector('[data-qf-service]');
      var areaSel = form.querySelector('[data-qf-area]');
      var etaBox = form.querySelector('[data-qf-eta]');
      var etaText = form.querySelector('[data-qf-eta-text]');
      var chips = form.querySelectorAll('[data-qf-chip]');

      // --- service chips drive the (still submitted) select ---
      function syncChips() {
        chips.forEach(function (c) {
          var on = c.getAttribute('data-qf-chip') === serviceSel.value;
          c.setAttribute('aria-pressed', String(on));
          // Must stay in step with the markup above, or a selected chip
          // changes size the moment it is clicked.
          c.className = on
            ? 'inline-flex items-center gap-1.5 rounded-full border border-navy-900 bg-navy-900 px-2.5 py-1 text-[0.82rem] font-semibold text-white transition-colors'
            : 'inline-flex items-center gap-1.5 rounded-full border border-line bg-cream px-2.5 py-1 text-[0.82rem] font-semibold text-navy-800 hover:border-navy-300 transition-colors';
        });
      }
      chips.forEach(function (c) {
        c.addEventListener('click', function () {
          var v = c.getAttribute('data-qf-chip');
          serviceSel.value = serviceSel.value === v ? '' : v;
          syncChips();
        });
      });
      if (serviceSel) { serviceSel.addEventListener('change', syncChips); syncChips(); }

      // --- live arrival estimate from the selected neighborhood ---
      function syncEta() {
        if (!areaSel || !etaBox) return;
        var opt = areaSel.options[areaSel.selectedIndex];
        var eta = opt && opt.getAttribute('data-eta');
        if (!eta) { etaBox.classList.add('hidden'); etaBox.classList.remove('flex'); return; }
        etaText.textContent = 'Typically ' + eta + ' from us in Bay Ridge.';
        etaBox.classList.remove('hidden');
        etaBox.classList.add('flex');
      }
      if (areaSel) { areaSel.addEventListener('change', syncEta); syncEta(); }

      // On success the form is done: swapping it for a confirmation is
      // clearer than a green strip under fields the customer has no reason to
      // look at again, and it stops accidental double submissions outright.
      function showSuccess(nm) {
        var body = form.querySelector('[data-qf-body]');
        if (!body) return;
        var first = (nm || '').split(' ')[0];
        body.innerHTML =
          '<div class="text-center py-6">' +
            '<div class="mx-auto w-14 h-14 rounded-full bg-green-100 border border-green-300 flex items-center justify-center">' +
              '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#15803d" stroke-width="2.5" ' +
                'stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>' +
            '</div>' +
            '<h2 class="display text-navy-900 text-[1.35rem] mt-4">' +
              (first ? 'Thanks, ' + first + ' — request sent' : 'Request sent') +
            '</h2>' +
            '<p class="mt-2 text-muted text-[0.95rem] leading-relaxed max-w-sm mx-auto">' +
              'We have your details and we will call you back shortly. ' +
              'We answer 7 AM to 11 PM, every day.' +
            '</p>' +
            '<a href="tel:' + phoneHref + '" class="btn btn-brass mt-5" data-call-cta="form-success">' +
              phone +
            '</a>' +
            '<p class="mt-3 text-[0.8rem] text-muted">In a hurry? Calling is always faster.</p>' +
          '</div>';
        body.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
      }

      function show(kind, html) {
        status.className =
          'mt-4 rounded-lg px-4 py-3 text-sm ' +
          (kind === 'ok'
            ? 'bg-green-50 text-green-900 border border-green-200'
            : 'bg-amber-50 text-amber-900 border border-amber-200');
        status.innerHTML = html;
        status.classList.remove('hidden');
      }

      form.addEventListener('submit', function (e) {
        e.preventDefault();
        if (form.company && form.company.value) return; // honeypot

        var name = form.name.value.trim();
        var tel = form.phone.value.trim();
        if (!name || !tel) {
          show('warn', 'Please add your name and a phone number so we can call you back.');
          return;
        }

        submit.disabled = true;
        submit.textContent = 'Sending…';

        fetch(form.action, { method: 'POST', body: new FormData(form) })
          .then(function (r) { return r.ok ? r.json().catch(function () { return { ok: true }; }) : Promise.reject(r); })
          .then(function () {
            showSuccess(name);
          })
          .catch(function () {
            var body = encodeURIComponent(
              'Name: ' + name +
              '\nPhone: ' + tel +
              '\nEmail: ' + ((form.email && form.email.value) || '—') +
              '\nService: ' + ((form.service && form.service.value) || '—') +
              '\nArea: ' + ((form.area && form.area.value) || '—') +
              '\n\n' + ((form.message && form.message.value) || '')
            );
            show(
              'warn',
              "Our form couldn't send just now. Please call <a class='underline font-semibold' href='tel:" + phoneHref + "'>" + phone +
                "</a> or <a class='underline font-semibold' href='mailto:" + email + '?subject=' +
                encodeURIComponent('Locksmith request from ' + name) + '&body=' + body +
                "'>email us directly</a> — your details are already filled in."
            );
          })
          .finally(function () {
            // The success path replaces the card body, so the button is gone.
            if (document.body.contains(submit)) {
              submit.disabled = false;
              submit.innerHTML = submitLabel;
            }
          });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initForms);
    } else {
      initForms();
    }
    document.addEventListener('astro:page-load', initForms);
  })();
</script>
