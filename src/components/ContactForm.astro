---
import Icon from './Icon.astro';
import { business } from '@/data/business';
import { services } from '@/data/services';
import { serviceAreas } from '@/data/locations';

interface Props {
  /** Preselect a service (used on service pages) */
  service?: string;
  /** Preselect an area */
  area?: string;
  compact?: boolean;
}
const { service = '', area = '', compact = false } = Astro.props;

const brooklyn = serviceAreas.filter((a) => a.region === 'Brooklyn');
const statenIsland = serviceAreas.filter((a) => a.region === 'Staten Island');
---
<form
  id="quote-form"
  class="card p-6 md:p-8"
  method="POST"
  action="/api/contact"
  novalidate
>
  {!compact && (
    <>
      <h2 class="display text-navy-900 text-2xl">Request a quote or callback</h2>
      <p class="mt-2 text-muted text-[0.95rem]">
        Locked out right now? <a href={`tel:${business.phoneHref}`} class="link-brass">Call {business.phoneDisplay}</a> —
        a phone call is always faster than a form.
      </p>
    </>
  )}

  <div class="mt-6 grid gap-4 sm:grid-cols-2">
    <div class="sm:col-span-1">
      <label for="qf-name" class="block text-sm font-bold text-navy-900 mb-1.5">
        Name <span class="text-brick-500">*</span>
      </label>
      <input
        id="qf-name" name="name" type="text" required autocomplete="name"
        class="w-full rounded-lg border border-line bg-white px-3.5 py-2.5 text-navy-900 placeholder:text-muted/60 focus:border-brass-400 focus:ring-2 focus:ring-brass-400/30 outline-none transition"
        placeholder="Your name"
      />
    </div>

    <div class="sm:col-span-1">
      <label for="qf-phone" class="block text-sm font-bold text-navy-900 mb-1.5">
        Phone <span class="text-brick-500">*</span>
      </label>
      <input
        id="qf-phone" name="phone" type="tel" required autocomplete="tel"
        class="w-full rounded-lg border border-line bg-white px-3.5 py-2.5 text-navy-900 placeholder:text-muted/60 focus:border-brass-400 focus:ring-2 focus:ring-brass-400/30 outline-none transition"
        placeholder="(347) 000-0000"
      />
    </div>

    <div class="sm:col-span-2">
      <label for="qf-email" class="block text-sm font-bold text-navy-900 mb-1.5">Email</label>
      <input
        id="qf-email" name="email" type="email" autocomplete="email"
        class="w-full rounded-lg border border-line bg-white px-3.5 py-2.5 text-navy-900 placeholder:text-muted/60 focus:border-brass-400 focus:ring-2 focus:ring-brass-400/30 outline-none transition"
        placeholder="you@example.com (optional)"
      />
    </div>

    <div class="sm:col-span-1">
      <label for="qf-service" class="block text-sm font-bold text-navy-900 mb-1.5">What do you need?</label>
      <select
        id="qf-service" name="service"
        class="w-full rounded-lg border border-line bg-white px-3.5 py-2.5 text-navy-900 focus:border-brass-400 focus:ring-2 focus:ring-brass-400/30 outline-none transition"
      >
        <option value="">Select a service…</option>
        {services.map((s) => (
          <option value={s.name} selected={s.slug === service || s.name === service}>{s.name}</option>
        ))}
        <option value="Something else">Something else</option>
      </select>
    </div>

    <div class="sm:col-span-1">
      <label for="qf-area" class="block text-sm font-bold text-navy-900 mb-1.5">Where are you?</label>
      <select
        id="qf-area" name="area"
        class="w-full rounded-lg border border-line bg-white px-3.5 py-2.5 text-navy-900 focus:border-brass-400 focus:ring-2 focus:ring-brass-400/30 outline-none transition"
      >
        <option value="">Select your neighborhood…</option>
        <optgroup label="Brooklyn">
          {brooklyn.map((a) => (
            <option value={`${a.name}, Brooklyn`} selected={a.slug === area || a.name === area}>{a.name}</option>
          ))}
        </optgroup>
        <optgroup label="Staten Island">
          {statenIsland.map((a) => (
            <option value={`${a.name}, Staten Island`} selected={a.slug === area || a.name === area}>{a.name}</option>
          ))}
        </optgroup>
      </select>
    </div>

    <div class="sm:col-span-2">
      <label for="qf-message" class="block text-sm font-bold text-navy-900 mb-1.5">Details</label>
      <textarea
        id="qf-message" name="message" rows="4"
        class="w-full rounded-lg border border-line bg-white px-3.5 py-2.5 text-navy-900 placeholder:text-muted/60 focus:border-brass-400 focus:ring-2 focus:ring-brass-400/30 outline-none transition resize-y"
        placeholder="Tell us about the door, the lock, or the car — the more detail, the more accurate the price."
      ></textarea>
    </div>
  </div>

  <!-- honeypot: bots fill this, humans never see it -->
  <div class="hidden" aria-hidden="true">
    <label for="qf-company">Company</label>
    <input id="qf-company" name="company" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <button type="submit" class="btn btn-brass w-full mt-6" id="qf-submit">
    <Icon name="arrow" size={18} />
    Send request
  </button>

  <p class="mt-3 text-xs text-muted text-center">
    We reply during business hours — every day, 7 AM to 11 PM. For anything urgent, call.
  </p>

  <div id="qf-status" class="mt-4 hidden rounded-lg px-4 py-3 text-sm" role="status" aria-live="polite"></div>
</form>

<script is:inline define:vars={{ phone: business.phoneDisplay, phoneHref: business.phoneHref, email: business.email }}>
  (function () {
    function initForm() {
      var form = document.getElementById('quote-form');
      if (!form || form.dataset.bound) return;
      form.dataset.bound = '1';

      var status = document.getElementById('qf-status');
      var submit = document.getElementById('qf-submit');

      function show(kind, html) {
        status.className =
          'mt-4 rounded-lg px-4 py-3 text-sm ' +
          (kind === 'ok'
            ? 'bg-green-50 text-green-900 border border-green-200'
            : 'bg-amber-50 text-amber-900 border border-amber-200');
        status.innerHTML = html;
        status.classList.remove('hidden');
      }

      form.addEventListener('submit', function (e) {
        e.preventDefault();
        if (form.company && form.company.value) return; // honeypot tripped

        var name = form.name.value.trim();
        var tel = form.phone.value.trim();
        if (!name || !tel) {
          show('warn', 'Please add your name and a phone number so we can call you back.');
          return;
        }

        submit.disabled = true;
        submit.textContent = 'Sending…';

        var data = new FormData(form);
        fetch(form.action, { method: 'POST', body: data })
          .then(function (r) { return r.ok ? r.json().catch(function(){return {ok:true};}) : Promise.reject(r); })
          .then(function () {
            form.reset();
            show('ok', "<strong>Got it.</strong> We'll call you back shortly. If it's urgent, ring <a class='underline font-semibold' href='tel:" + phoneHref + "'>" + phone + '</a>.');
          })
          .catch(function () {
            // No mail backend wired yet (or a network failure) — never lose the lead.
            var body = encodeURIComponent(
              'Name: ' + name +
              '\nPhone: ' + tel +
              '\nEmail: ' + (form.email.value || '—') +
              '\nService: ' + (form.service.value || '—') +
              '\nArea: ' + (form.area.value || '—') +
              '\n\n' + (form.message.value || '')
            );
            show(
              'warn',
              "Our form couldn't send just now. Please call <a class='underline font-semibold' href='tel:" + phoneHref + "'>" + phone +
                "</a> or <a class='underline font-semibold' href='mailto:" + email + '?subject=' +
                encodeURIComponent('Locksmith request from ' + name) + '&body=' + body +
                "'>email us directly</a> — your details are already filled in."
            );
          })
          .finally(function () {
            submit.disabled = false;
            submit.textContent = 'Send request';
          });
      });
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initForm);
    } else {
      initForm();
    }
    document.addEventListener('astro:page-load', initForm);
  })();
</script>
