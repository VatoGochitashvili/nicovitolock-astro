---
/**
 * Generated SVG backdrops — no image files, no stock photography.
 *
 * Every variant is drawn from the trade or the territory, so the texture is
 * specific to this business rather than a generic gradient:
 *   bitting  — the cut profile of a key, repeated as a skyline
 *   pins     — pin-tumbler stacks, like the inside of a cylinder
 *   grid     — a street grid on the Brooklyn angle
 *   rings    — concentric cylinder cross-sections
 *   subway   — offset beveled tile, the wall of every station on the R line
 *              and half the kitchens in Brooklyn
 *
 * They render as inline SVG (a few hundred bytes, gzipped to almost nothing)
 * and sit BEHIND content at very low opacity. Text contrast is unaffected:
 * the strokes never exceed 0.06 alpha on dark or 0.05 on light.
 */
interface Props {
  variant?: 'bitting' | 'pins' | 'grid' | 'rings' | 'subway';
  /** 'dark' = light strokes for navy sections, 'light' = navy strokes for cream */
  tone?: 'dark' | 'light';
  class?: string;
  /** Multiplier on the base opacity, 0–2 */
  intensity?: number;
}
const { variant = 'grid', tone = 'dark', class: className = '', intensity = 1 } = Astro.props;

const stroke = tone === 'dark' ? '#ffffff' : '#1a3341';
const accent = '#f2ae39';
const base = tone === 'dark' ? 0.055 : 0.045;
const o = (n: number) => (base * n * intensity).toFixed(4);
// The pattern id is keyed on the props, so two Backdrops with identical props
// share it — harmless, since identical props draw an identical pattern. Two
// with DIFFERENT props always differ. The build audit checks for duplicate
// element ids across all pages and currently reports zero.
const id = `bd-${variant}-${tone}-${String(intensity).replace('.', '')}`;
---
<div
  class:list={['pointer-events-none absolute inset-0 overflow-hidden', className]}
  aria-hidden="true"
>
  <svg class="w-full h-full" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
    <defs>
      {variant === 'bitting' && (
        <pattern id={id} width="240" height="120" patternUnits="userSpaceOnUse">
          {/* the cut profile of a key blade, repeated */}
          <path
            d="M0 84 H18 L26 62 H44 L52 84 H70 L78 50 H96 L104 78 H122 L130 58 H148 L156 86 H174 L182 54 H200 L208 80 H240"
            fill="none" stroke={stroke} stroke-width="2" stroke-opacity={o(1)}
            stroke-linejoin="round" stroke-linecap="round"
          />
          <circle cx="196" cy="30" r="9" fill="none" stroke={accent} stroke-width="2" stroke-opacity={o(1.5)} />
        </pattern>
      )}

      {variant === 'pins' && (
        <pattern id={id} width="132" height="200" patternUnits="userSpaceOnUse">
          {/* pin-tumbler stacks at varying shear heights */}
          {[10, 32, 54, 76, 98, 120].map((x, i) => {
            const h = [58, 92, 44, 108, 70, 84][i];
            return (
              <>
                <line x1={x} y1="0" x2={x} y2={h} stroke={stroke} stroke-width="2" stroke-opacity={o(1)} />
                <circle cx={x} cy={h + 8} r="4.5" fill="none" stroke={stroke} stroke-width="2" stroke-opacity={o(1.2)} />
                <line x1={x} y1={h + 16} x2={x} y2="200" stroke={stroke} stroke-width="2" stroke-opacity={o(0.5)} />
              </>
            );
          })}
          <line x1="0" y1="150" x2="132" y2="150" stroke={accent} stroke-width="1.5" stroke-opacity={o(1.2)} />
        </pattern>
      )}

      {variant === 'grid' && (
        <pattern id={id} width="160" height="160" patternUnits="userSpaceOnUse" patternTransform="rotate(29)">
          {/* street grid, rotated onto the Brooklyn angle */}
          <path d="M0 0 H160 M0 52 H160 M0 104 H160" stroke={stroke} stroke-width="1.5" stroke-opacity={o(1)} />
          <path d="M0 0 V160 M56 0 V160 M112 0 V160" stroke={stroke} stroke-width="1.5" stroke-opacity={o(0.7)} />
          <rect x="56" y="52" width="56" height="52" fill={stroke} fill-opacity={o(0.35)} />
          <circle cx="112" cy="52" r="3.5" fill={accent} fill-opacity={o(2.2)} />
        </pattern>
      )}

      {variant === 'subway' && (
        <pattern id={id} width="120" height="80" patternUnits="userSpaceOnUse">
          {/* 3x6 proportion, running bond — the standard subway tile. Two
              rows offset by half a tile is the whole pattern. */}
          <g fill="none" stroke={stroke} stroke-width="1.5" opacity={o(1)}>
            <rect x="0" y="0" width="58" height="38" rx="2" />
            <rect x="62" y="0" width="58" height="38" rx="2" />
            <rect x="-30" y="42" width="58" height="38" rx="2" />
            <rect x="32" y="42" width="58" height="38" rx="2" />
            <rect x="94" y="42" width="58" height="38" rx="2" />
          </g>
          {/* the bevel: a highlight along the top-left of each tile */}
          <g fill="none" stroke={accent} stroke-width="1" opacity={o(0.5)}>
            <path d="M2 36 L2 2 L56 2" />
            <path d="M64 36 L64 2 L118 2" />
            <path d="M34 78 L34 44 L88 44" />
            <path d="M96 78 L96 44 L150 44" />
          </g>
        </pattern>
      )}

      {variant === 'rings' && (
        <pattern id={id} width="260" height="260" patternUnits="userSpaceOnUse">
          {/* cylinder cross-sections */}
          {[26, 52, 78, 104].map((r) => (
            <circle cx="130" cy="130" r={r} fill="none" stroke={stroke} stroke-width="1.5" stroke-opacity={o(1)} />
          ))}
          <circle cx="130" cy="130" r="10" fill="none" stroke={accent} stroke-width="2" stroke-opacity={o(2)} />
          <line x1="130" y1="26" x2="130" y2="234" stroke={stroke} stroke-width="1" stroke-opacity={o(0.5)} />
        </pattern>
      )}
    </defs>
    <rect width="100%" height="100%" fill={`url(#${id})`} />
  </svg>
</div>
