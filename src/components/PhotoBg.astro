---
/**
 * Hero background: the designed HeroArt plate, plus — when a photo is given —
 * the owner's photograph as a crisp card on the right (PhotoCard).
 *
 * Photos are no longer dimmed behind the text. The old blurred-fill + scrim
 * treatment read as a muddy, darkened picture; this keeps the type on a clean
 * designed surface and shows the job photo in full colour beside it.
 * `texture`, `layout` and `strength` are accepted for compatibility.
 */
import HeroArt from './HeroArt.astro';
import PhotoCard from './PhotoCard.astro';

interface Props {
  photo?: string;
  texture?: 'vanblur' | 'storefront-blur';
  layout?: 'right' | 'beside-form';
  strength?: number;
  eager?: boolean;
  class?: string;
}
const { photo, eager = false, class: cls = '' } = Astro.props;
---
<div class:list={['hero-bg absolute inset-0 overflow-hidden', cls]}>
  <HeroArt />
</div>
{photo && <PhotoCard photos={[photo]} eager={eager} />}
