---
/**
 * Photographic band background: one PhotoFrame plus the text scrim.
 * See PhotoFrame for why photos are shown whole rather than cropped.
 */
import PhotoFrame from './PhotoFrame.astro';
import Scrim from './Scrim.astro';

interface Props {
  /** /work slug of one of the owner's photographs */
  photo?: string;
  /** Full-bleed blurred texture from the owner's own shots */
  texture?: 'vanblur' | 'storefront-blur';
  layout?: 'right' | 'beside-form';
  /** 0–100: how much photo shows through. */
  strength?: number;
  eager?: boolean;
  class?: string;
}
const { photo, texture, layout = 'right', strength = 55, eager = false, class: cls = '' } = Astro.props;
---
<div class:list={['hero-bg absolute inset-0 overflow-hidden', cls]}>
  <PhotoFrame photo={photo} texture={texture} layout={layout} eager={eager} />
  <Scrim strength={strength} />
</div>
