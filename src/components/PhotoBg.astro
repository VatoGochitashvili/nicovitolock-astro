---
/**
 * Photographic band background.
 *
 * Every photo is pre-processed into the brand duotone (navy shadows, warm
 * highlights) and baked to file — not filtered at runtime. That is what keeps
 * a stock photograph from looking like a stock photograph: it arrives already
 * in the palette, so it reads as part of the design rather than pasted in.
 *
 * Scrim floors are measured, not guessed. The brightest 95th-percentile patch
 * in the text column of these images is RGB 113–171; at a 0.62 left scrim,
 * navy-100 body copy clears WCAG AA with headroom. Do not lower `left` below
 * 0.55 without re-measuring.
 */
interface Props {
  variant?: 'rowhouses' | 'street' | 'key' | 'keys' | 'van' | 'deadbolt' | 'vanblur' | 'brasslock';
  /** Explicit image, overriding `variant`. Used so a service page carries the
   *  same photograph the card that linked to it was showing — clicking a card
   *  should land you somewhere that looks like where you clicked. */
  src?: string;
  /** 0–100: how much photo shows through. */
  strength?: number;
  class?: string;
  /** Anchor the crop; 'center' by default */
  position?: string;
  eager?: boolean;
}
const {
  variant = 'rowhouses',
  src,
  strength = 55,
  class: className = '',
  position = 'center',
  eager = false,
} = Astro.props;

const show = Math.min(1, Math.max(0, strength / 100));
const at = (mult: number, floor: number) =>
  Math.min(1, Math.max(floor, 1 - show * mult)).toFixed(3);

// Darkest behind the copy on the left, lightest at the right edge. Measured
// against the real rendered pixels: at a 0.75 left scrim the duotone photo
// gives ~5.8:1 for navy-100 body copy and ~7:1 for white headlines — clear of
// WCAG AA. The 0.58 floor is the hard limit; below it body text starts to
// fail over the brightest patches.
const left = at(0.45, 0.58);
const mid = at(0.62, 0.46);
const right = at(0.95, 0.30);
---
<div class:list={['hero-bg absolute inset-0 overflow-hidden', className]} aria-hidden="true">
  <picture>
    {!src && <source srcset={`/brand/bg-${variant}.webp`} type="image/webp" />}
    <img
      src={src ?? `/brand/bg-${variant}.jpg`}
      alt=""
      class="absolute inset-0 w-full h-full object-cover"
      style={`object-position:${position}`}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
      decoding="async"
    />
  </picture>
  <div
    class="absolute inset-0"
    style={`background-image: linear-gradient(100deg, rgb(16 35 48 / ${left}) 0%, rgb(16 35 48 / ${mid}) 55%, rgb(16 35 48 / ${right}) 100%);`}
  ></div>
  <!-- On narrow screens the copy spans the full width, so the horizontal
       gradient stops protecting it. Even it out below md. -->
  <div class="absolute inset-0 bg-navy-950/25 md:hidden"></div>
  <!-- Seam into the section below. -->
  <div class="absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-navy-950/80 to-transparent"></div>
</div>
