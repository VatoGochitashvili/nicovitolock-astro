---
import type { WorkPhoto } from '@/data/work';

/**
 * Real photographs of our own work. Shown in natural colour, not the brand
 * duotone — the duotone is for backgrounds, where the image is atmosphere.
 * Here the photo IS the evidence, and washing it into two tones would make
 * genuine proof look like stock.
 */
interface Props {
  photos: WorkPhoto[];
  heading?: string;
  intro?: string;
  limit?: number;
  tone?: 'light' | 'dark';
  class?: string;
}
const {
  photos,
  heading = 'Recent work',
  intro,
  limit = 6,
  tone = 'light',
  class: className = '',
} = Astro.props;

const shown = photos.slice(0, limit);
if (!shown.length) return null;

const dark = tone === 'dark';
---
<section class:list={['py-14 md:py-18', dark ? 'bg-navy-900' : 'bg-cream-deep', className]}>
  <div class="container-x">
    <div class="pb-4 mb-7 border-b-2" class:list={[dark ? 'border-white/15' : 'border-navy-900']}>
      <p class:list={[
        'font-display text-[0.7rem] font-bold uppercase tracking-[0.26em] mb-3',
        dark ? 'text-brass-400' : 'text-brass-600',
      ]}>
        On the job
      </p>
      <h2 class:list={['display text-2xl md:text-[2.1rem]', dark ? 'text-white' : 'text-navy-900']}>
        {heading}
      </h2>
      {intro && (
        <p class:list={['mt-3 max-w-2xl leading-relaxed', dark ? 'text-navy-200' : 'text-muted']}>
          {intro}
        </p>
      )}
    </div>

    <ul class="grid grid-cols-2 lg:grid-cols-3 gap-4 md:gap-5">
      {shown.map((p, i) => (
        <li class="reveal" data-delay={i * 60}>
          <figure class="group">
            <div class:list={[
              'overflow-hidden rounded-xl border',
              dark ? 'border-white/10' : 'border-line',
              p.orientation === 'portrait' ? 'aspect-[3/4]' : 'aspect-[4/3]',
            ]}>
              <img
                src={`/work/${p.slug}-800.webp`}
                srcset={`/work/${p.slug}-800.webp 800w, /work/${p.slug}.webp 1200w`}
                sizes="(min-width: 1024px) 380px, (min-width: 640px) 45vw, 45vw"
                alt={p.alt}
                width="800"
                height={p.orientation === 'portrait' ? 1067 : 600}
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
              />
            </div>
            <figcaption class:list={[
              'mt-2.5 text-[0.85rem] leading-snug',
              dark ? 'text-navy-200' : 'text-muted',
            ]}>
              {p.caption}
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </div>
</section>
