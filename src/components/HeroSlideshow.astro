---
/**
 * Hero background with several of the owner's job photos: the HeroArt plate
 * plus a PhotoCard that cross-fades between them. See PhotoBg / PhotoCard.
 */
import HeroArt from './HeroArt.astro';
import PhotoCard from './PhotoCard.astro';

interface Props {
  photos: string[];
  layout?: 'right' | 'beside-form';
  hold?: number;
  strength?: number;
}
const { photos, hold = 5 } = Astro.props;
---
<div class="hero-bg absolute inset-0 overflow-hidden">
  <HeroArt />
</div>
<PhotoCard photos={photos} hold={hold} eager />
