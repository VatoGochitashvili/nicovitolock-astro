---
/**
 * Facebook / Instagram / Yelp / Nextdoor / Google profile icons. Each renders only when its
 * URL is set in business.social, so adding a profile there is all it takes.
 */
import Icon from './Icon.astro';
import { business } from '@/data/business';

interface Props {
  tone?: 'dark' | 'light';
  size?: 'sm' | 'md';
  /** Also show the Google Business Profile (map pin) */
  google?: boolean;
  class?: string;
}
const { tone = 'dark', size = 'md', google = false, class: cls = '' } = Astro.props;
const links = [
  { href: business.social.facebook, icon: 'facebook', label: 'Nico & Vito Locksmith on Facebook' },
  { href: business.social.instagram, icon: 'instagram', label: 'Nico & Vito Locksmith on Instagram' },
  { href: business.social.yelp, icon: 'yelp', label: 'Nico & Vito Locksmith on Yelp' },
  { href: business.social.nextdoor, icon: 'nextdoor', label: 'Nico & Vito Locksmith on Nextdoor' },
  ...(google ? [{ href: business.social.google, icon: 'pin', label: 'Nico & Vito Locksmith on Google Maps' }] : []),
].filter((l) => l.href);
const box = size === 'sm' ? 'w-7 h-7' : 'w-10 h-10';
const px = size === 'sm' ? 15 : 19;
const look = tone === 'dark'
  ? 'border-white/20 text-white hover:bg-white hover:text-navy-950'
  : 'border-navy-900/25 text-navy-900 hover:bg-navy-950 hover:text-white';
---
{links.length > 0 && (
  <ul class:list={['flex items-center gap-2', cls]} aria-label="Follow us">
    {links.map((l) => (
      <li>
        <a
          href={l.href}
          target="_blank"
          rel="noopener"
          aria-label={l.label}
          title={l.label}
          class:list={['inline-flex items-center justify-center rounded-full border transition-colors', box, look]}
        >
          <Icon name={l.icon} size={px} />
        </a>
      </li>
    ))}
  </ul>
)}
