---
/**
 * Text protection over a photo band. Darkest behind the copy on the left,
 * lightest at the right where the uncropped photo sits.
 *
 * The 0.58 left floor is measured, not guessed: below it body copy starts to
 * fail WCAG AA over the brightest patches. Do not lower it without
 * re-measuring. Below md the copy spans the full width and sits directly on
 * the photo, so a flat layer evens it out there.
 */
interface Props { strength?: number }
const { strength = 50 } = Astro.props;
const show = Math.min(1, Math.max(0, strength / 100));
const at = (m: number, floor: number) => Math.min(1, Math.max(floor, 1 - show * m)).toFixed(3);
const left = at(0.45, 0.58), mid = at(0.62, 0.46), right = at(0.95, 0.22);
---
<div
  class="absolute inset-0 pointer-events-none"
  aria-hidden="true"
  style={`background-image: linear-gradient(100deg, rgb(16 35 48 / ${left}) 0%, rgb(16 35 48 / ${mid}) 50%, rgb(16 35 48 / ${right}) 100%);`}
></div>
<div class="absolute inset-0 bg-navy-950/45 md:hidden pointer-events-none" aria-hidden="true"></div>
<div class="absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-navy-950/80 to-transparent pointer-events-none" aria-hidden="true"></div>
