---
/**
 * Dimmed photographic hero background.
 *   variant="neighborhood" — Brooklyn row houses (home, area pages)
 *   variant="truck"        — the van (service pages)
 *   variant="avenue"       — a Brooklyn commercial strip
 *
 * The photo renders at full opacity and a single navy scrim does all the
 * dimming — layering an opacity fade UNDER a scrim just compounds and the
 * image disappears. The scrim is a left-to-right gradient so the headline
 * column stays darkest (and legible) while texture shows on the right.
 */
interface Props {
  variant?: 'neighborhood' | 'truck' | 'avenue';
  /** 0–100: how much photo shows through. ~20 is subtle, ~45 is prominent. */
  strength?: number;
  class?: string;
}
const { variant = 'neighborhood', strength = 32, class: className = '' } = Astro.props;

const srcs = {
  neighborhood: '/brand/bg-rowhouses.jpg',
  truck: '/brand/van-2.jpg',
  avenue: '/brand/bg-avenue.jpg',
};
const src = srcs[variant];

const show = Math.min(1, Math.max(0, strength / 100));
// Darkest at the left edge (behind the headline and body copy), lightest at
// the right. Floors are not arbitrary: the brightest 95th-percentile patch in
// bg-rowhouses.jpg is ~RGB(233) (snow and window trim), and measured against
// it a 0.72 scrim keeps navy-100 body text at ~6:1 — clear of WCAG AA. Do not
// lower the left floor without re-measuring.
const at = (mult: number, floor: number) =>
  Math.min(1, Math.max(floor, 1 - show * mult)).toFixed(3);
const left = at(0.42, 0.72);
const mid = at(0.55, 0.62);
const right = at(0.88, 0.48);
---
<div class:list={['hero-bg absolute inset-0 overflow-hidden', className]} aria-hidden="true">
  <img
    src={src}
    alt=""
    class="absolute inset-0 w-full h-full object-cover"
    style="filter: saturate(0.62) contrast(1.06) brightness(1.12);"
    loading="lazy"
    decoding="async"
  />
  <div
    class="absolute inset-0"
    style={`background-image: linear-gradient(100deg, rgb(16 35 48 / ${left}) 0%, rgb(16 35 48 / ${mid}) 55%, rgb(16 35 48 / ${right}) 100%);`}
  ></div>
  <!-- On narrow screens the copy spans the full width, so the left-to-right
       gradient no longer protects it. Add uniform dimming below md. -->
  <div class="absolute inset-0 bg-navy-950/15 md:hidden"></div>
  <!-- Soften the seam into the section below. -->
  <div class="absolute inset-x-0 bottom-0 h-28 bg-gradient-to-t from-navy-950/85 to-transparent"></div>
</div>
