---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Icon from '@/components/Icon.astro';
import CtaBand from '@/components/CtaBand.astro';
import GoogleReviewBand from '@/components/GoogleReviewBand.astro';
import FaqAccordion from '@/components/FaqAccordion.astro';
import ContactForm from '@/components/ContactForm.astro';
import WorkGallery from '@/components/WorkGallery.astro';
import { photosForService } from '@/data/work';
import { services } from '@/data/services';
import { vehicles } from '@/data/vehicles';
import { serviceAreas, tier1Areas } from '@/data/locations';
import { business } from '@/data/business';
import { breadcrumbSchema, serviceSchema, faqSchema, clampDescription, pickTitle } from '@/lib/seo';

export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;

const photoFor: Record<string, 'key' | 'keys' | 'van' | 'rowhouses' | 'street'> = {
  Emergency: 'key',
  Residential: 'keys',
  Automotive: 'van',
  Commercial: 'street',
  Security: 'rowhouses',
};
const sceneFor: Record<string, 'residential' | 'automotive' | 'commercial' | 'security' | 'emergency'> = {
  Emergency: 'emergency',
  Residential: 'residential',
  Automotive: 'automotive',
  Commercial: 'commercial',
  Security: 'security',
};


const related = services.filter((s) => s.slug !== service.slug).slice(0, 3);
const photos = photosForService(service.slug);
const brooklyn = tier1Areas.filter((a) => a.region === 'Brooklyn');
const statenIsland = tier1Areas.filter((a) => a.region === 'Staten Island');

const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Services', url: '/services' },
  { name: service.name, url: `/services/${service.slug}` },
];

const description = clampDescription(
  `${service.name} in Brooklyn & Staten Island. ${service.summary} Licensed Bay Ridge locksmith, open daily 7AM–11PM. Call ${business.phone}.`
);

const title = pickTitle([
  `${service.name} in Brooklyn & Staten Island | Nico & Vito`,
  `${service.name} Brooklyn & Staten Island | Nico & Vito`,
  `${service.name} in Brooklyn NY | Nico & Vito Locksmith`,
  `${service.name} | Nico & Vito Locksmith Brooklyn`,
  `${service.name} | Brooklyn & Staten Island`,
]);

const schema = [
  breadcrumbSchema(crumbs),
  serviceSchema({
    name: service.name,
    description: service.summary,
    url: `/services/${service.slug}`,
    images: photos.map((p) => p.slug),
  }),
  faqSchema(service.faqs),
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={`/services/${service.slug}`}
  schema={schema}
>
  <PageHero
    eyebrow={service.category}
    title={`${service.name} in Brooklyn & Staten Island`}
    subtitle={service.summary}
    crumbs={crumbs}
    scene={sceneFor[service.category]}
    photo={photoFor[service.category]}
  />

  <section class="py-14 md:py-18 bg-cream">
    <div class="container-x grid lg:grid-cols-12 gap-10 lg:gap-14">
      <!-- Main column -->
      <div class="lg:col-span-7">
        <div class="prose-local text-[1.06rem]">
          <p class="text-navy-800 text-[1.15rem] leading-relaxed">{service.intro}</p>
          <p>{service.detail}</p>
        </div>

        <!-- What's included -->
        <div class="mt-9">
          <h2 class="display text-navy-900 text-2xl md:text-[1.85rem]">What's included</h2>
          <span class="rule-brass mt-3 block"></span>
          <ul class="mt-5 grid sm:grid-cols-2 gap-x-6 gap-y-3">
            {service.features.map((f) => (
              <li class="flex items-start gap-2.5">
                <span class="w-5 h-5 rounded-full bg-brass-400 text-navy-950 grid place-items-center shrink-0 mt-0.5">
                  <Icon name="check" size={12} />
                </span>
                <span class="text-navy-800">{f}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Scenarios -->
        <div class="mt-10">
          <h2 class="display text-navy-900 text-2xl md:text-[1.85rem]">
            What people call us about
          </h2>
          <span class="rule-brass mt-3 block"></span>
          <ul class="mt-5 space-y-2.5">
            {service.scenarios.map((s) => (
              <li class="flex items-start gap-3 bg-white border border-line rounded-lg px-4 py-3">
                <Icon name="wrench" size={18} class="text-brass-500 shrink-0 mt-0.5" />
                <span class="text-navy-800">{s}</span>
              </li>
            ))}
          </ul>
        </div>

        {service.slug === 'car-key-replacement' && (
          <div class="mt-10">
            <h2 class="display text-navy-900 text-2xl md:text-[1.85rem]">Find your make</h2>
            <span class="rule-brass mt-3 block"></span>
            <p class="mt-4 text-muted leading-relaxed">
              Every make has its own key system and its own honest answer about what a
              locksmith can do at the roadside. Pick yours for the specifics.
            </p>
            <ul class="mt-5 flex flex-wrap gap-2">
              {vehicles.map((v) => (
                <li>
                  <a
                    href={`/car-keys/${v.slug}`}
                    class="inline-flex items-center gap-1.5 px-3 py-1.5 border border-line bg-white text-[0.87rem] text-navy-800 hover:bg-navy-900 hover:text-white hover:border-navy-900 transition-colors"
                  >
                    <Icon name="car" size={13} class="text-brass-500" />
                    {v.make}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}

        <!-- Local coverage -->
        <div class="mt-10">
          <h2 class="display text-navy-900 text-2xl md:text-[1.85rem]">
            {service.name} near you
          </h2>
          <span class="rule-brass mt-3 block"></span>
          <p class="mt-4 text-muted leading-relaxed">
            We're based in Bay Ridge and cover {serviceAreas.length} neighborhoods.
            Pick yours for local pricing, arrival times, and detail specific to your streets.
          </p>

          <h3 class="mt-6 font-display font-bold text-navy-900 text-[1.05rem]">Brooklyn</h3>
          <div class="mt-3 flex flex-wrap gap-2">
            {brooklyn.map((a) => (
              <a
                href={`/services/${service.slug}/${a.slug}`}
                class="px-2.5 py-1.5 rounded-md bg-white border border-line text-[0.85rem] text-navy-800 hover:bg-brass-400 hover:border-brass-400 hover:text-navy-950 transition-colors"
              >{a.name}</a>
            ))}
          </div>

          <h3 class="mt-6 font-display font-bold text-navy-900 text-[1.05rem]">Staten Island</h3>
          <div class="mt-3 flex flex-wrap gap-2">
            {statenIsland.map((a) => (
              <a
                href={`/services/${service.slug}/${a.slug}`}
                class="px-2.5 py-1.5 rounded-md bg-white border border-line text-[0.85rem] text-navy-800 hover:bg-brass-400 hover:border-brass-400 hover:text-navy-950 transition-colors"
              >{a.name}</a>
            ))}
          </div>

          <p class="mt-5 text-sm text-muted">
            Don't see your block? <a href="/service-areas" class="link-brass">See all {serviceAreas.length} neighborhoods</a> —
            we cover all of Brooklyn and Staten Island.
          </p>
        </div>
      </div>

      <!-- Sidebar -->
      <aside class="lg:col-span-5 space-y-5">
        <div class="card p-6 tex-navy rounded-[--radius-card]">
          <h2 class="text-white text-xl">Get a price now</h2>
          <p class="mt-2 text-navy-200 text-[0.95rem] leading-relaxed">
            Call and describe the job. We quote {service.short.toLowerCase()} over the phone
            before we head out — and that's the price you pay.
          </p>
          <a href={`tel:${business.phoneHref}`} class="btn btn-brass w-full mt-5" data-call-cta="service-sidebar">
            <Icon name="phone" size={18} />
            {business.phoneDisplay}
          </a>
          <ul class="mt-5 space-y-2 text-sm text-navy-200">
            {[
              'Open every day 7 AM – 11 PM',
              'Licensed & insured',
              'No trip surcharge in our areas',
            ].map((t) => (
              <li class="flex items-center gap-2">
                <Icon name="check" size={15} class="text-brass-400 shrink-0" />
                {t}
              </li>
            ))}
          </ul>
        </div>

        <ContactForm service={service.name} compact />

        <div class="card p-6">
          <h2 class="text-navy-900 text-lg">Related services</h2>
          <ul class="mt-4 space-y-2.5">
            {related.map((r) => (
              <li>
                <a href={`/services/${r.slug}`} class="flex items-center gap-3 group">
                  <span class="w-8 h-8 rounded-md bg-navy-50 text-navy-700 grid place-items-center shrink-0 group-hover:bg-brass-400 group-hover:text-navy-950 transition-colors">
                    <Icon name={r.icon} size={16} />
                  </span>
                  <span class="text-navy-800 font-semibold text-[0.95rem] group-hover:text-brass-600 transition-colors">
                    {r.name}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </aside>
    </div>
  </section>

  {photos.length > 0 && (
    <WorkGallery
      photos={photos}
      heading={`${service.name} — our own work`}
      intro="Photographs from real jobs across Brooklyn and Staten Island. Not stock."
      limit={6}
    />
  )}

  <FaqAccordion faqs={service.faqs} heading={`${service.name} — questions we get`} />

  <GoogleReviewBand tone="navy" />

  <CtaBand
    heading={`Need ${service.short.toLowerCase()} today?`}
    body={`We're open every day 7 AM to 11 PM and cover all of Brooklyn and Staten Island from Bay Ridge.`}
  />
</BaseLayout>
