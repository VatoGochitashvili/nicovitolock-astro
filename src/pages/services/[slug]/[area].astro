---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Backdrop from '@/components/Backdrop.astro';
import Scene from '@/components/Scene.astro';
import PhotoBg from '@/components/PhotoBg.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Icon from '@/components/Icon.astro';
import CtaBand from '@/components/CtaBand.astro';
import FaqAccordion from '@/components/FaqAccordion.astro';
import ContactForm from '@/components/ContactForm.astro';
import WorkGallery from '@/components/WorkGallery.astro';
import { ownPhotosForService } from '@/data/work';
import { services } from '@/data/services';
import { tier1Areas, nearbyAreas } from '@/data/locations';
import { business } from '@/data/business';
import { localCopy, traitNote, localLists, seededHash, pickManyPublic } from '@/lib/localize';
import { breadcrumbSchema, serviceSchema, faqSchema, pickTitle } from '@/lib/seo';

export function getStaticPaths() {
  return services.flatMap((service) =>
    tier1Areas.map((area) => ({
      params: { slug: service.slug, area: area.slug },
      props: { service, area },
    }))
  );
}

const { service, area } = Astro.props;

const sceneFor: Record<string, 'residential' | 'automotive' | 'commercial' | 'security' | 'emergency'> = {
  Emergency: 'emergency',
  Residential: 'residential',
  Automotive: 'automotive',
  Commercial: 'commercial',
  Security: 'security',
};

const photoFor: Record<string, 'key' | 'keys' | 'van' | 'rowhouses' | 'street'> = {
  Emergency: 'key',
  Residential: 'keys',
  Automotive: 'van',
  Commercial: 'street',
  Security: 'rowhouses',
};
const copy = localCopy(service, area);
const note = traitNote(service, area);
const lists = localLists(service, area);
// Seeded slice so neighbouring pages don't all show the same three photos.
const allPhotos = ownPhotosForService(service.slug);
const offset = allPhotos.length ? seededHash(area.slug) % allPhotos.length : 0;
const photos = allPhotos.length ? [...allPhotos.slice(offset), ...allPhotos.slice(0, offset)].slice(0, 3) : [];
const near = nearbyAreas(area);
// Seeded rather than the first six, so the cross-link block is not the same
// twelve words on all 55 pages of a service.
const otherServices = pickManyPublic(
  services.filter((s) => s.slug !== service.slug),
  seededHash(`other::${service.slug}::${area.slug}`),
  3,
  6,
);

const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Services', url: '/services' },
  { name: service.name, url: `/services/${service.slug}` },
  { name: area.name, url: `/services/${service.slug}/${area.slug}` },
];

const title = pickTitle([
  `${service.name} in ${area.name}, ${area.region} | Nico & Vito`,
  `${service.name} in ${area.name} | Nico & Vito Locksmith`,
  `${service.name} in ${area.name} | Nico & Vito`,
  `${service.short} in ${area.name} | Nico & Vito Locksmith`,
  `${service.short} in ${area.name} | Nico & Vito`,
  `${service.short} in ${area.name}, ${area.region}`,
]);

const schema = [
  breadcrumbSchema(crumbs),
  serviceSchema({
    name: `${service.name} in ${area.name}`,
    description: copy.metaDescription,
    url: `/services/${service.slug}/${area.slug}`,
    areaName: area.name,
    areaRegion: area.region,
  }),
  faqSchema(copy.faqs),
];

const facts = [
  { k: 'Typical arrival', v: area.eta, i: 'bolt' },
  { k: 'Hours', v: 'Every day, 7am–11pm', i: 'clock' },
  { k: 'Coverage', v: `${area.name} ${area.zip}`, i: 'pin' },
  { k: 'Trip surcharge', v: 'None', i: 'dollar' },
];
---

<BaseLayout
  title={title}
  description={copy.metaDescription}
  canonical={`/services/${service.slug}/${area.slug}`}
  schema={schema}
>
  <!-- Header plate -->
  <section class="relative bg-navy-900 overflow-hidden">
    <PhotoBg variant={photoFor[service.category]} strength={46} eager />
    <Scene variant={sceneFor[service.category]} class="h-[58%]" opacity={0.11} />
    <div class="absolute left-0 inset-y-0 w-1 bg-brass-400 z-[1]" aria-hidden="true"></div>
    <span
      class="pointer-events-none select-none absolute -right-2 top-1/2 -translate-y-1/2 display text-white/[0.04] text-[7rem] lg:text-[11rem] leading-none whitespace-nowrap"
      aria-hidden="true">{area.zip}</span>

    <div class="container-x relative z-[1] py-11 md:py-14">
      <Breadcrumbs items={crumbs} light />
      <p class="mt-6 mb-4 font-display text-[0.7rem] font-bold uppercase tracking-[0.26em] text-brass-400">
        {area.name} · {area.region}
      </p>
      <h1 class="display text-white text-[2rem] sm:text-[2.7rem] lg:text-[3.3rem] max-w-4xl leading-[1.04]">
        {service.name} in {area.name}
      </h1>
      <p class="mt-4 text-navy-200 text-lg max-w-2xl leading-relaxed">{copy.lead}</p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a href={`tel:${business.phoneHref}`} class="btn btn-brass" data-call-cta="local-hero">
          <Icon name="phone" size={18} />
          {business.phoneDisplay}
        </a>
        <a href="#quote" class="btn btn-ghost">Get a price</a>
      </div>
    </div>
  </section>

  <!-- Facts strip — replaces the old sidebar card -->
  <section class="bg-navy-800 border-b border-white/10">
    <div class="container-x grid grid-cols-2 lg:grid-cols-4 divide-x divide-white/10">
      {facts.map((f) => (
        <div class="py-4 px-4 first:pl-0 last:pr-0">
          <p class="flex items-center gap-1.5 text-[0.65rem] uppercase tracking-[0.14em] text-navy-300">
            <Icon name={f.i} size={13} class="text-brass-400 shrink-0" />
            {f.k}
          </p>
          <p class="mt-1 text-white font-semibold text-[0.95rem]">{f.v}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Body — single measured column, no sidebar -->
  <section class="relative overflow-hidden py-14 md:py-18 bg-cream">
    <Backdrop variant="grid" tone="light" intensity={0.7} />
    <div class="container-x relative z-[1]">
      <div class="max-w-3xl prose-local text-[1.06rem]">
        <p class="text-navy-800 text-[1.15rem] leading-relaxed">{copy.localAngle}</p>
        <p>{note}</p>
        {copy.traitNotes.map((t) => <p>{t}</p>)}
      </div>

      <div class="mt-12 grid md:grid-cols-2 gap-10 md:gap-14 max-w-5xl">
        <div>
          <h2 class="display text-navy-900 text-xl md:text-2xl pb-3 border-b-2 border-navy-900">
            {copy.whyHeading}
          </h2>
          <ul class="mt-5 space-y-2.5">
            {lists.features.map((f) => (
              <li class="flex items-start gap-2.5">
                <Icon name="check" size={16} class="text-brass-600 shrink-0 mt-1" />
                <span class="text-navy-800">{f}</span>
              </li>
            ))}
          </ul>
        </div>

        <div>
          <h2 class="display text-navy-900 text-xl md:text-2xl pb-3 border-b-2 border-navy-900">
            {copy.scenarioHeading}
          </h2>
          <ul class="mt-5 space-y-2.5">
            {lists.scenarios.map((s) => (
              <li class="flex items-start gap-2.5">
                <Icon name="wrench" size={16} class="text-brass-600 shrink-0 mt-1" />
                <span class="text-navy-800">{s}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <div class="mt-12 max-w-3xl prose-local text-[1.06rem]">
        <h2 class="display text-navy-900 text-xl md:text-2xl mb-4">
          Booking {service.short.toLowerCase()} in {area.name}
        </h2>
        <p>{copy.process}</p>
        <p>{copy.landmarkLine}{copy.coverage ? ` ${copy.coverage}` : ''}</p>
        <p>{copy.close}</p>
      </div>

      {copy.fieldNotes.length > 0 && (
        <div class="mt-12 max-w-3xl grid gap-6">
          {copy.fieldNotes.map((n) => (
            <p class="border-l-2 border-brass-400 pl-5 text-navy-800 leading-relaxed">{n}</p>
          ))}
        </div>
      )}
    </div>
  </section>

  <!-- Quote band — full width, where the sidebar form used to be -->
  <section class="relative overflow-hidden py-14 md:py-18 bg-navy-900" id="quote">
    <Backdrop variant="rings" tone="dark" />
    <div class="container-x relative z-[1] grid lg:grid-cols-12 gap-10 lg:gap-16 items-center">
      <div class="lg:col-span-5">
        <h2 class="display text-white text-2xl md:text-[2.1rem]">
          Get a price for {area.name}
        </h2>
        <p class="mt-4 text-navy-200 leading-relaxed">{copy.quoteBlurb}</p>
        <a href={`tel:${business.phoneHref}`} class="btn btn-brass mt-6" data-call-cta="local-band">
          <Icon name="phone" size={18} />
          {business.phoneDisplay}
        </a>
      </div>
      <div class="lg:col-span-7">
        <ContactForm variant="short" tone="dark" service={service.name} area={area.name} />
      </div>
    </div>
  </section>

  <!-- Related, laid out horizontally -->
  <section class="py-14 bg-cream-deep">
    <div class="container-x">
      <h2 class="display text-navy-900 text-xl md:text-2xl pb-3 mb-6 border-b-2 border-navy-900">
        Other services in {area.name}
      </h2>
      <ul class="grid sm:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-1">
        {otherServices.map((s) => (
          <li class="border-b border-line">
            <a href={`/services/${s.slug}/${area.slug}`} class="group flex items-center gap-3 py-3">
              <Icon name={s.icon} size={17} class="text-brass-600 shrink-0" />
              <span class="text-navy-800 font-semibold text-[0.95rem] group-hover:text-brass-600 transition-colors">
                {s.short} in {area.name}
              </span>
              <Icon name="arrow" size={15} class="text-brass-500 ml-auto shrink-0 opacity-0 group-hover:opacity-100 transition-opacity" />
            </a>
          </li>
        ))}
      </ul>

      {near.length > 0 && (
        <>
          <h2 class="display text-navy-900 text-xl md:text-2xl pb-3 mt-12 mb-6 border-b-2 border-navy-900">
            {service.short} near {area.name}
          </h2>
          <ul class="flex flex-wrap gap-2">
            {near.map((n) => (
              <li>
                <a
                  href={n.tier === 1 ? `/services/${service.slug}/${n.slug}` : `/service-areas/${n.slug}`}
                  class="inline-flex items-center gap-1.5 px-3 py-1.5 border border-line bg-white text-[0.87rem] text-navy-800 hover:bg-navy-900 hover:text-white hover:border-navy-900 transition-colors"
                >
                  <Icon name="pin" size={13} class="text-brass-500" />
                  {n.name}
                </a>
              </li>
            ))}
          </ul>
        </>
      )}
    </div>
  </section>

  {photos.length > 0 && (
    <WorkGallery
      photos={photos}
      heading={`${service.short} work from the road`}
      intro={copy.galleryIntro}
      limit={3}
    />
  )}

  <FaqAccordion faqs={copy.faqs} heading={`${service.short} in ${area.name} — common questions`} />

  <CtaBand
    heading={`${service.name} in ${area.name}?`}
    body={copy.ctaBody}
  />
</BaseLayout>
