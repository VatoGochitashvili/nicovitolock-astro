---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Icon from '@/components/Icon.astro';
import CtaBand from '@/components/CtaBand.astro';
import { services } from '@/data/services';
import { business } from '@/data/business';
import { breadcrumbSchema, faqSchema } from '@/lib/seo';

const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Pricing', url: '/pricing' },
];

const priced = services.filter((s) => s.priceFrom && s.priceFrom.startsWith('$'));
const quoted = services.filter((s) => !s.priceFrom || !s.priceFrom.startsWith('$'));

const faqs = [
  {
    q: 'Why do you publish prices when most locksmiths do not?',
    a: "Because hiding them is how the bait-and-switch works. A published starting price gives you something to hold us to. These are honest starting points for straightforward jobs — we still quote your specific job on the phone before coming out.",
  },
  {
    q: 'What makes a job cost more than the starting price?',
    a: "High-security or unusual hardware, a door that needs repair as well as a lock, multiple cylinders, a vehicle with a dealer-locked immobiliser, or a job that needs two people. We tell you which of these applies when you describe the job — not when we're standing at your door.",
  },
  {
    q: 'Is there a call-out or trip fee?',
    a: "There's no surcharge for your neighborhood anywhere in our service area. If a job involves a service charge for coming out, we say so on the phone before you agree to anything.",
  },
  {
    q: 'What payment methods do you take?',
    a: `${business.paymentAccepted}. You get a receipt for the work either way.`,
  },
  {
    q: 'Do you quote before starting the work?',
    a: 'Always. You hear the price on the phone, we confirm it on site, and if the job genuinely turns out to be different from what was described we stop and tell you before doing anything further.',
  },
];
---

<BaseLayout
  title="Locksmith Prices | Brooklyn & Staten Island | Nico & Vito"
  description="Honest starting prices for lockouts, rekeys, lock changes, car keys and more. No bait pricing, no trip surcharge. Bay Ridge locksmith, open daily 7AM–11PM."
  canonical="/pricing"
  schema={[breadcrumbSchema(crumbs), faqSchema(faqs)]}
>
  <PageHero
    eyebrow="Pricing"
    title="What a locksmith should actually cost"
    subtitle="Real starting prices, published on purpose — so you have something to hold us to."
    crumbs={crumbs}
  />

  <!-- The warning -->
  <section class="py-12 md:py-14 bg-cream">
    <div class="container-x">
      <div class="card p-6 md:p-8 border-l-4 border-l-brick-500 max-w-4xl">
        <h2 class="display text-navy-900 text-2xl flex items-center gap-3">
          <Icon name="bolt" size={24} class="text-brick-500 shrink-0" />
          Read this before you call anyone
        </h2>
        <div class="mt-4 space-y-3 text-muted leading-relaxed">
          <p>
            If a locksmith quotes you <strong class="text-navy-900">$19 or $29</strong> over
            the phone for a lockout, that is not a price — it is a hook. What follows is
            well documented and always the same: a subcontractor arrives, inspects the lock,
            declares it "high security," drills it out in under two minutes, replaces it with
            a cheap cylinder, and presents a bill for $250–$500. The number you were quoted
            was for the service call only.
          </p>
          <p>
            Ask any locksmith three questions before they come out:
            <strong class="text-navy-900">what is the total price including parts and labor</strong>,
            <strong class="text-navy-900">are you licensed and insured</strong>, and
            <strong class="text-navy-900">what is your business address</strong>. A real
            locksmith answers all three without hesitating.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Price table -->
  <section class="pb-14 md:pb-18 bg-cream">
    <div class="container-x">
      <h2 class="display text-navy-900 text-2xl md:text-[2.1rem]">Starting prices</h2>
      <span class="rule-brass mt-3 block"></span>
      <p class="mt-4 text-muted max-w-2xl leading-relaxed">
        These are genuine starting points for straightforward jobs in our service area.
        Your exact price depends on the hardware and the situation — call
        <a href={`tel:${business.phoneHref}`} class="link-brass">{business.phoneDisplay}</a> and
        we'll quote your specific job before we come out.
      </p>

      <div class="mt-8 overflow-x-auto">
        <table class="w-full min-w-[560px] border-collapse">
          <thead>
            <tr class="bg-navy-800 text-white text-left">
              <th class="font-display font-bold px-5 py-3.5 rounded-tl-lg">Service</th>
              <th class="font-display font-bold px-5 py-3.5">What it covers</th>
              <th class="font-display font-bold px-5 py-3.5 text-right rounded-tr-lg whitespace-nowrap">From</th>
            </tr>
          </thead>
          <tbody>
            {priced.map((s, i) => (
              <tr class:list={['border-b border-line', i % 2 === 1 && 'bg-white/60']}>
                <td class="px-5 py-4 align-top">
                  <a href={`/services/${s.slug}`} class="font-semibold text-navy-900 hover:text-brass-600 transition-colors">
                    {s.name}
                  </a>
                </td>
                <td class="px-5 py-4 align-top text-[0.92rem] text-muted">{s.summary}</td>
                <td class="px-5 py-4 align-top text-right whitespace-nowrap">
                  <span class="display text-navy-900 text-lg">{s.priceFrom}</span>
                </td>
              </tr>
            ))}
            {quoted.map((s, i) => (
              <tr class:list={['border-b border-line', (priced.length + i) % 2 === 1 && 'bg-white/60']}>
                <td class="px-5 py-4 align-top">
                  <a href={`/services/${s.slug}`} class="font-semibold text-navy-900 hover:text-brass-600 transition-colors">
                    {s.name}
                  </a>
                </td>
                <td class="px-5 py-4 align-top text-[0.92rem] text-muted">{s.summary}</td>
                <td class="px-5 py-4 align-top text-right whitespace-nowrap">
                  <span class="badge bg-navy-50 text-navy-700">Quoted on site</span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <p class="mt-4 text-sm text-muted">
        Prices are starting points for standard hardware in Brooklyn and Staten Island, and
        may change with the specific lock, door, or vehicle. Nothing here is a binding quote —
        your quote comes on the phone, before we roll out.
      </p>
    </div>
  </section>

  <!-- What's never charged -->
  <section class="py-14 tex-navy">
    <div class="container-x">
      <div class="max-w-2xl mb-8">
        <p class="eyebrow eyebrow--light mb-3">No surprises</p>
        <h2 class="display text-white text-2xl md:text-[2.1rem]">What we never add at the door</h2>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {[
          { t: 'Neighborhood surcharge', d: 'Same price in Tottenville as in Bay Ridge.' },
          { t: 'Evening or weekend rate', d: 'One rate, all our open hours, every day.' },
          { t: '"High security" upcharge', d: 'If your lock needs different parts, you hear it on the phone.' },
          { t: 'Mystery labor line', d: 'The quote includes labor. That is the point of a quote.' },
        ].map((x, i) => (
          <div class="bg-white/5 border border-white/10 rounded-xl p-5 reveal" data-delay={i * 60}>
            <Icon name="close" size={20} class="text-brick-500" />
            <h3 class="mt-3 text-white text-[1.05rem]">{x.t}</h3>
            <p class="mt-1.5 text-navy-200 text-[0.9rem] leading-relaxed">{x.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-14 md:py-18 bg-cream-deep">
    <div class="container-narrow">
      <h2 class="display text-navy-900 text-2xl md:text-[2.1rem]">Pricing questions</h2>
      <span class="rule-brass mt-3 block"></span>
      <div class="mt-6 space-y-3">
        {faqs.map((f, i) => (
          <details class="card overflow-hidden reveal" data-delay={i * 45} open={i === 0}>
            <summary class="flex items-center justify-between gap-4 p-5 font-display font-bold text-navy-900 text-[1.03rem]">
              {f.q}
              <Icon name="chevron" size={20} class="acc-chevron text-brass-500 shrink-0" />
            </summary>
            <div class="px-5 pb-5 -mt-1 text-muted leading-relaxed">{f.a}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <CtaBand
    heading="Want a price for your job?"
    body="Describe the door, the lock, or the car. We'll give you a number on the phone."
  />
</BaseLayout>
