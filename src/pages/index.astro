  .hero-eta-out { flex-basis: 100%; min-height: 1.4rem; font-size: 0.98rem; color: #dfeaee; }
  .hero-eta-out a { color: #f2ae39; text-decoration: underline; text-underline-offset: 3px; }

  @media (prefers-reduced-motion: reduce) {
