    .hero-spot { display: none; }
  }
</style>

<script is:inline>
  (function () {
    var hero = document.querySelector('section.hero');
    if (!hero) return;

    // Pointer spotlight (skipped for touch and reduced motion).
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!reduce && window.matchMedia('(pointer: fine)').matches) {
      var raf = 0;
      hero.addEventListener('pointermove', function (e) {
        if (raf) return;
        raf = requestAnimationFrame(function () {
          raf = 0;
          var r = hero.getBoundingClientRect();
          hero.style.setProperty('--mx', (e.clientX - r.left) + 'px');
          hero.style.setProperty('--my', (e.clientY - r.top) + 'px');
        });
      });
    }

    // Map pins: hover or keyboard focus shows name + drive time and draws the
    // route from Bay Ridge; clicking is a normal link to the area page.
    var mapBox = hero.querySelector('.hero-map');
    var tip = hero.querySelector('[data-hm-tip]');
    var routeEl = hero.querySelector('[data-hm-pick-route]');
    var baseDot = hero.querySelector('.hm-base');
    function drawRoute(pin) {
      if (!routeEl || !baseDot || !pin) return;
      var bx = +baseDot.getAttribute('cx'), by = +baseDot.getAttribute('cy');
      var px = +pin.getAttribute('cx'), py = +pin.getAttribute('cy');
      var cx = (bx + px) / 2 + (py - by) * 0.18, cy = (by + py) / 2 - (px - bx) * 0.18;
      routeEl.setAttribute('d', 'M' + bx + ' ' + by + ' Q ' + cx + ' ' + cy + ' ' + px + ' ' + py);
      routeEl.classList.remove('is-drawing'); void routeEl.getBoundingClientRect(); routeEl.classList.add('is-drawing');
    }
    function showTip(link) {
      if (!tip || !mapBox) return;
      var pin = link.querySelector('.hm-pin');
      var r = pin.getBoundingClientRect(), m = mapBox.getBoundingClientRect();
      tip.innerHTML = '';
      tip.appendChild(document.createTextNode(link.getAttribute('data-hm-name')));
      var sub = document.createElement('span');
      sub.textContent = link.getAttribute('data-hm-eta') + ' from Bay Ridge · click to open';
      tip.appendChild(sub);
      tip.style.left = (r.left + r.width / 2 - m.left) + 'px';
      tip.style.top = (r.top - m.top) + 'px';
      tip.hidden = false;
      drawRoute(pin);
    }
    function hideTip() {
      if (tip) tip.hidden = true;
      var picked = hero.querySelector('.hm-pin.is-picked');
      if (picked) drawRoute(picked); else if (routeEl) routeEl.classList.remove('is-drawing');
    }
    hero.querySelectorAll('.hm-link').forEach(function (link) {
      link.addEventListener('mouseenter', function () { showTip(link); });
      link.addEventListener('focus', function () { showTip(link); });
      link.addEventListener('mouseleave', hideTip);
      link.addEventListener('blur', hideTip);
    });

    // Arrival picker: drive time + light the neighbourhood up on the map.
    var sel = document.getElementById('hero-eta');
    var out = hero.querySelector('[data-hero-eta-out]');
    var route = hero.querySelector('[data-hm-pick-route]');
    var baseEl = hero.querySelector('.hm-base');
    if (!sel || !out) return;
    sel.addEventListener('change', function () {
      hero.querySelectorAll('.hm-pin.is-picked').forEach(function (p) { p.classList.remove('is-picked'); });
      var opt = sel.options[sel.selectedIndex];
      if (!sel.value) { out.textContent = ''; if (route) route.classList.remove('is-drawing'); return; }
      var name = opt.getAttribute('data-name'), eta = opt.getAttribute('data-eta');
      out.innerHTML = '';
      var t = document.createElement('span');
      t.textContent = name + ' — ' + eta + ' from our Bay Ridge base. ';
      var a = document.createElement('a');
      a.href = '/service-areas/' + sel.value + '/';
      a.textContent = 'See ' + name + ' →';
      out.appendChild(t); out.appendChild(a);

      var pin = hero.querySelector('.hm-pin[data-hm-slug="' + sel.value + '"]');
      if (pin && route && baseEl) {
        pin.classList.add('is-picked');
        var bx = +baseEl.getAttribute('cx'), by = +baseEl.getAttribute('cy');
        var px = +pin.getAttribute('cx'), py = +pin.getAttribute('cy');
        var cx = (bx + px) / 2 + (py - by) * 0.18, cy = (by + py) / 2 - (px - bx) * 0.18;
        route.setAttribute('d', 'M' + bx + ' ' + by + ' Q ' + cx + ' ' + cy + ' ' + px + ' ' + py);
        route.classList.remove('is-drawing'); void route.getBoundingClientRect(); route.classList.add('is-drawing');
      }
    });
  })();
</script>
