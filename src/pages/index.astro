    .hero-center .hero-map svg { position: absolute; top: 47%; left: 50%; width: 124%; height: 92%; transform: translate(-50%, -50%); }
  }
  .hm-route, .hm-base, .hm-base-ring,
  .hm-boro, .hm-bridge, .hm-bridge-label { pointer-events: none; }
  .hm-boro { fill: rgb(255 255 255 / 0.2); font: 800 34px var(--font-display, sans-serif); letter-spacing: 0.2em; }
  .hm-bridge { stroke: #f2ae39; stroke-width: 5; stroke-dasharray: 2 12; stroke-linecap: round; opacity: 0.8; }
  .hm-bridge-label { fill: rgb(242 174 57 / 0.75); font: 600 italic 34px var(--font-sans, sans-serif); }
  .hm-pin--near { fill: #f2ae39; }
  .hm-pin--mid  { fill: rgb(244 194 100 / 0.6); }
  .hm-pin--far  { fill: rgb(144 179 192 / 0.55); }
  .hm-legend { position: absolute; left: 50%; bottom: 0; transform: translateX(-50%); display: flex; gap: 0.9rem;
    white-space: nowrap; font-size: 0.72rem; font-weight: 600; color: rgb(223 234 238 / 0.75); }
  .hm-legend li { display: inline-flex; align-items: center; gap: 0.35rem; }
  .hm-key { width: 0.55rem; height: 0.55rem; border-radius: 999px; display: inline-block; }
  .hm-key--near { background: #f2ae39; } .hm-key--mid { background: rgb(244 194 100 / 0.6); } .hm-key--far { background: rgb(144 179 192 / 0.7); }
  .hm-link { cursor: pointer; outline: none; }
  .hm-hit { fill: transparent; }
  .hm-link:hover .hm-pin, .hm-link:focus-visible .hm-pin { fill: #fff; transform: scale(2.2); }
  .hm-link:focus-visible .hm-hit { stroke: #f2ae39; stroke-width: 3; }
  .hm-tip {
    position: absolute; z-index: 2; pointer-events: none; transform: translate(-50%, calc(-100% - 12px));
    padding: 0.4rem 0.7rem; border-radius: 0.6rem; white-space: nowrap;
