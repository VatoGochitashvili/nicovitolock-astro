---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import Backdrop from '@/components/Backdrop.astro';
import PhotoBg from '@/components/PhotoBg.astro';
import JobsStrip from '@/components/JobsStrip.astro';
import CoverageMap from '@/components/CoverageMap.astro';
import ContactForm from '@/components/ContactForm.astro';
import GoogleReviewBand from '@/components/GoogleReviewBand.astro';
import Reviews from '@/components/Reviews.astro';
import CtaBand from '@/components/CtaBand.astro';
import FaqAccordion from '@/components/FaqAccordion.astro';
import { business } from '@/data/business';
import { services } from '@/data/services';
import { serviceAreas } from '@/data/locations';
import { serviceCardPhoto, homeHeroPhotos } from '@/data/work';
import { vehicles } from '@/data/vehicles';
import { localBusinessSchema, webSiteSchema, faqSchema } from '@/lib/seo';

const brooklynAreas = serviceAreas.filter((a) => a.region === 'Brooklyn');
const siAreas = serviceAreas.filter((a) => a.region === 'Staten Island');

const homeFaqs = [
  {
    q: 'Are you open 24 hours?',
    a: "No, and we'd rather say so plainly. We're open every day from 7 AM to 11 PM, weekends and holidays included. Plenty of locksmiths advertise 24/7 and then don't answer at 3 AM — we tell you our real hours so you know exactly when you can reach a person.",
  },
  {
    q: 'What areas do you cover?',
    a: `All of Brooklyn and all of Staten Island — ${serviceAreas.length} neighborhoods in total. We're based in Bay Ridge, so southwest Brooklyn is fastest, and Staten Island is a straight run over the Verrazzano.`,
  },
  {
    q: 'How much does a locksmith cost?',
    a: "It depends on the job — the door, the hardware, and what has actually gone wrong. That is why we quote before we come out rather than after. Describe it on the phone and you get a real number, and that number is the one you pay. No bait price that triples at the door.",
  },
  {
    q: 'How fast can you get here?',
    a: "Most Brooklyn calls we reach in 20–30 minutes. Staten Island typically runs 30–45 depending on where you are and what the bridge looks like. We give you a real window when you call, not a vague 'on our way.'",
  },
  {
    q: 'Are you licensed and insured?',
    a: "Yes. We're a licensed and insured New York locksmith. Ask to see credentials when we arrive — any legitimate locksmith will have them on hand, and you should be suspicious of one who doesn't.",
  },
  {
    q: 'Will you damage my lock getting me in?',
    a: "Almost never. We pick or bypass in the large majority of lockouts, which leaves your existing lock fully usable. Drilling is a last resort, and if it's genuinely necessary we tell you and quote the replacement before touching the door.",
  },
];

const schema = [localBusinessSchema(), webSiteSchema(), faqSchema(homeFaqs)];

// ── Hero coverage map: every neighbourhood as a dot, in its real position ──
// Equirectangular projection with longitude scaled by cos(latitude), which is
// accurate to within a few pixels over an area this small.
const MAP_W = 1000;
const lats = serviceAreas.map((a) => a.coords[0]);
const lngs = serviceAreas.map((a) => a.coords[1]);
const pad = 0.012;
const minLat = Math.min(...lats) - pad, maxLat = Math.max(...lats) + pad;
const minLng = Math.min(...lngs) - pad, maxLng = Math.max(...lngs) + pad;
const kx = Math.cos((((minLat + maxLat) / 2) * Math.PI) / 180);
const spanX = (maxLng - minLng) * kx, spanY = maxLat - minLat;
const MAP_H = Math.round((MAP_W * spanY) / spanX);
const project = ([lat, lng]: [number, number]) => ({
  x: +(((lng - minLng) * kx) / spanX * MAP_W).toFixed(1),
  y: +(((maxLat - lat) / spanY) * MAP_H).toFixed(1),
});
const mapPins = serviceAreas.map((a) => ({ slug: a.slug, name: a.name, region: a.region, eta: a.eta, ...project(a.coords) }));
const base = mapPins.find((p) => p.slug === 'bay-ridge')!;
// Neighbourhoods the ambient "dispatch" animation cycles through.
const dispatchSlugs = ['sunset-park', 'brighton-beach', 'park-slope', 'st-george', 'canarsie', 'brooklyn-heights', 'great-kills', 'bensonhurst'];
const dispatches = dispatchSlugs.map((s) => mapPins.find((p) => p.slug === s)).filter(Boolean) as typeof mapPins;
const DISPATCH_EVERY = 3.2; // seconds between routes

const title = 'Locksmith Brooklyn & Staten Island | Nico & Vito';
const description =
  `Licensed Bay Ridge locksmith covering all of Brooklyn & Staten Island. Lockouts, rekeys, car keys, intercoms, cameras. Open daily 7AM–11PM. ${business.phoneDisplay}.`;
---

<BaseLayout title={title} description={description} schema={schema} canonical="/">

  <!-- ══════════════ 01 · HERO ══════════════
       Calm but alive: slow drifting light behind everything, a live open/
       closed pill, an underline that draws itself, and a soft glow behind
       the form. No photographs or line art behind the type — the owner found
       those busy. Everything is still under prefers-reduced-motion. -->
  <section class="hero relative isolate overflow-hidden bg-navy-900">
    <div class="hero-aurora" aria-hidden="true">
      <span class="orb orb-a"></span>
      <span class="orb orb-b"></span>
      <span class="orb orb-c"></span>
    </div>

    <div class="hero-spot" aria-hidden="true"></div>

    <div class="container-x relative py-12 md:py-16 lg:py-20">
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-x-14 lg:items-center">

        <div class="hero-rise lg:col-span-7">
          <p class="hero-pill" data-hero-hours>
            <span class="hero-dot" data-hero-dot></span>
            <span data-hero-hours-text>Open every day 7 AM – 11 PM</span>
            <span class="text-white/35">·</span>
            <span>Bay Ridge, Brooklyn</span>
          </p>

          <h1 class="mt-6 display text-white text-[2.1rem] sm:text-[2.7rem] lg:text-[3.35rem] leading-[1.05]">
            The Brooklyn locksmith<br class="hidden sm:block" />
            your block <span class="hero-underline">already calls.<svg viewBox="0 0 300 18" preserveAspectRatio="none" aria-hidden="true"><path d="M3 13 C 70 4, 150 3, 297 9" /></svg></span>
          </h1>

          <p class="mt-6 text-navy-200 text-[1.05rem] md:text-lg leading-relaxed max-w-lg">
            Lockouts, lock changes, car keys, intercoms and cameras — across Brooklyn
            and Staten Island.
          </p>

          <div class="mt-8 flex flex-col sm:flex-row sm:items-center gap-4 sm:gap-6">
            <a href={`tel:${business.phoneHref}`} class="btn btn-brass btn-lg hero-cta" data-call-cta="hero-primary">
              <Icon name="phone" size={20} />
              {business.phoneDisplay}
            </a>
            <a href={business.smsHref} class="hero-ghost" data-cta="sms">
              <Icon name="message" size={18} /> Text us
            </a>
          </div>

          <!-- Arrival picker: real drive times from locations.ts; lights the
               neighbourhood up on the map and draws the route from Bay Ridge. -->
          <div class="hero-eta mt-7">
            <label for="hero-eta" class="hero-eta-label"><Icon name="bolt" size={15} /> How far are we?</label>
            <select id="hero-eta" class="hero-eta-select">
              <option value="">Pick your neighborhood</option>
              <optgroup label="Brooklyn">
                {mapPins.filter((p) => p.region === 'Brooklyn').map((p) => <option value={p.slug} data-eta={p.eta} data-name={p.name}>{p.name}</option>)}
              </optgroup>
              <optgroup label="Staten Island">
                {mapPins.filter((p) => p.region === 'Staten Island').map((p) => <option value={p.slug} data-eta={p.eta} data-name={p.name}>{p.name}</option>)}
              </optgroup>
            </select>
            <p class="hero-eta-out" data-hero-eta-out aria-live="polite"></p>
          </div>

          <ul class="mt-7 flex flex-wrap gap-2.5 text-[0.86rem]">
            <li class="hero-chip"><Icon name="badge" size={15} class="text-brass-400" /> Licensed &amp; insured</li>
            <li class="hero-chip"><Icon name="bolt" size={15} class="text-brass-400" /> 20–30 min across Brooklyn</li>
            <li class="hero-chip"><Icon name="star" size={15} class="text-brass-400" /> {business.googleRating} on Google</li>
          </ul>
        </div>

        <div class="lg:col-span-5 w-full max-w-md lg:max-w-none mx-auto relative hero-form">
          <div class="hero-glow" aria-hidden="true"></div>
          <ContactForm variant="short" tone="dark" hideContactRow />
          <!-- Coverage map: every neighbourhood we serve, in its real position, with
               routes drawing out from the Bay Ridge base. Every pin is a link to
               its neighbourhood page; hover or focus shows the drive time. -->
          <div class="hero-map" role="group" aria-label="Coverage map — choose a neighborhood to open its page">
            <div class="hm-tip" data-hm-tip hidden></div>
            <p class="hero-map-cap" aria-hidden="true"><span class="hm-cap-dot"></span> {serviceAreas.length} neighborhoods · dispatched from Bay Ridge</p>
            <svg viewBox={`0 0 ${MAP_W} ${MAP_H}`} preserveAspectRatio="xMidYMid meet">
              {dispatches.map((d, i) => (
                <path class="hm-route" pathLength="1" d={`M${base.x} ${base.y} Q ${(base.x + d.x) / 2 + (d.y - base.y) * 0.18} ${(base.y + d.y) / 2 - (d.x - base.x) * 0.18} ${d.x} ${d.y}`}
                  style={`animation-delay:${(i * DISPATCH_EVERY).toFixed(1)}s; animation-duration:${(dispatches.length * DISPATCH_EVERY).toFixed(1)}s`} />
              ))}
              <path class="hm-route hm-route--picked" pathLength="1" d="" data-hm-pick-route />
              {mapPins.map((p) => (
                <a href={`/service-areas/${p.slug}/`} class="hm-link" data-hm-name={p.name} data-hm-eta={p.eta} aria-label={`Locksmith in ${p.name} — ${p.eta} away`}>
                  <circle class="hm-hit" cx={p.x} cy={p.y} r="30" />
                  <circle class="hm-pin" cx={p.x} cy={p.y} r="7" data-hm-slug={p.slug} />
                </a>
              ))}
              {dispatches.map((d, i) => (
                <circle class="hm-ping" cx={d.x} cy={d.y} r="7"
                  style={`animation-delay:${(i * DISPATCH_EVERY + 1.1).toFixed(1)}s; animation-duration:${(dispatches.length * DISPATCH_EVERY).toFixed(1)}s`} />
              ))}
              <circle class="hm-base-ring" cx={base.x} cy={base.y} r="14" />
              <circle class="hm-base" cx={base.x} cy={base.y} r="12" />
              <text class="hm-base-label" x={base.x + 22} y={base.y + 10}>Bay Ridge</text>
            </svg>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Own job photos, shown whole, under the hero rather than behind it. -->
  <JobsStrip photos={homeHeroPhotos} />

  <GoogleReviewBand />

  <!-- Live Google reviews: hidden until the Worker has real ones to show. -->
  <Reviews limit={6} optional />

  <!-- ══════════════ 02 · HOURS HONESTY ══════════════ -->
  <section class="bg-white border-b border-line-cool">
    <div class="container-x py-5 flex flex-col sm:flex-row items-center justify-center gap-3 text-center sm:text-left">
      <Icon name="clock" size={19} class="text-brass-600 shrink-0" />
      <p class="text-navy-800 text-[0.98rem]">
        Not a 24/7 operation — open <strong class="text-navy-900">every day, 7 AM to 11 PM</strong>.
        <span class="text-muted">Inside those hours a locksmith actually answers the phone.</span>
      </p>
    </div>
  </section>

  <!-- ══════════════ 03 · SERVICES — bento grid ══════════════ -->
  <section class="relative overflow-hidden py-16 md:py-22 bg-cream" id="services">
    <Backdrop variant="subway" tone="light" intensity={0.55} />
    <div class="container-x relative z-[1]">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-5 mb-9">
        <div class="max-w-xl">
          <p class="font-display text-[0.7rem] font-bold uppercase tracking-[0.26em] text-brass-600 mb-3">
            What we do
          </p>
          <h2 class="display text-navy-900 text-3xl md:text-[2.7rem] leading-[1.05]">
            Locked out, or locking up?<br class="hidden sm:block" />
            <span class="text-brass-600">Start here.</span>
          </h2>
        </div>
        <a href="/services/" class="btn btn-outline shrink-0">
          All {services.length} services
          <Icon name="arrow" size={17} />
        </a>
      </div>

      {/* Two feature tiles span wide so the grid has rhythm instead of reading
          like a spreadsheet of identical squares. */}
      <div class="svc-grid">
        {services.map((s, i) => {
          const wide = i === 0 || i === 5;
          return (
            <a
              href={`/services/${s.slug}/`}
              class:list={['svc-card reveal', wide && 'svc-card--wide']}
              data-delay={Math.min(i, 7) * 45}
            >
              <img
                src={`/work/${serviceCardPhoto[s.slug]}-card.webp`}
                alt={`${s.name} in Brooklyn and Staten Island — Nico & Vito Locksmith`}
                width="760" height="475" loading="lazy" decoding="async"
              />
              <span class="svc-card__icon">
                <Icon name={s.icon} size={17} />
              </span>
              <span class="svc-card__body">
                <span class="svc-card__rule block mb-2.5"></span>
                <span class:list={[
                  'font-display font-bold text-white leading-tight block',
                  wide ? 'text-[1.25rem] md:text-[1.5rem]' : 'text-[1.02rem] md:text-[1.12rem]',
                ]}>{s.name}</span>
                <span class="svc-card__desc block">{s.summary}</span>
              </span>
            </a>
          );
        })}
      </div>

      <div class="mt-10 pt-8 border-t border-line">
        <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-3 mb-4">
          <h3 class="display text-navy-900 text-xl">Car keys, by make</h3>
          <a href="/car-keys/" class="text-navy-900 font-semibold border-b-2 border-brass-400 pb-0.5 hover:text-brass-600 transition-colors">
            All {vehicles.length} makes →
          </a>
        </div>
        <ul class="flex flex-wrap gap-2">
          {vehicles.map((v) => (
            <li>
              <a
                href={`/car-keys/${v.slug}/`}
                class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-line bg-white text-[0.87rem] text-navy-800 hover:bg-navy-900 hover:text-white hover:border-navy-900 hover:-translate-y-0.5 transition-all duration-200"
              >
                <Icon name="car" size={13} class="text-brass-500" />
                {v.make}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ══════════════ 04 · HOW WE QUOTE ══════════════ -->
  <section class="relative overflow-hidden py-16 md:py-20 bg-navy-900">
    <PhotoBg texture="vanblur" strength={30} />
    <Backdrop variant="rings" tone="dark" intensity={0.5} />
    <div class="container-x relative z-[1] grid lg:grid-cols-12 gap-10 lg:gap-16">
      <div class="lg:col-span-5">
        <p class="font-display text-[0.7rem] font-bold uppercase tracking-[0.26em] text-brass-400 mb-3">
          How we quote
        </p>
        <h2 class="display text-white text-3xl md:text-[2.5rem]">
          The number on the phone is the number you pay
        </h2>
        <p class="mt-5 text-navy-200 leading-relaxed">
          Rock-bottom lockout quotes advertised elsewhere are a hook — the tech
          arrives, calls your lock "high security," drills it, and hands you a bill
          many times what you were told. We price the actual job, before we leave
          Bay Ridge, and we hold to it.
        </p>
        <a href="/contact/" class="btn btn-brass mt-7">
          Get a quote
          <Icon name="arrow" size={17} />
        </a>
      </div>

      <div class="lg:col-span-7">
        <ol class="divide-y divide-white/10 border-y border-white/10">
          {[
            { n: '01', t: 'You describe the job', d: 'The door, the lock, or the vehicle — and what actually happened.' },
            { n: '02', t: 'We quote it', d: 'A real figure for the real work, before anybody drives anywhere.' },
            { n: '03', t: 'Anything changes, you hear it first', d: 'If the job on site is genuinely different, we stop and tell you — never after.' },
            { n: '04', t: 'You pay what we said', d: 'No neighborhood surcharge, no evening rate, no invented labor line.' },
          ].map((x) => (
            <li class="flex items-baseline gap-5 py-5">
              <span class="font-display font-bold text-[0.85rem] text-brass-400 tabular-nums shrink-0">{x.n}</span>
              <div>
                <h3 class="text-white font-display font-bold text-[1.05rem]">{x.t}</h3>
                <p class="mt-1 text-navy-200 text-[0.95rem] leading-relaxed">{x.d}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- ══════════════ 05 · WHY US — stat strip + proof ══════════════ -->
  <section class="relative overflow-hidden bg-cream-deep">
    <div class="grid lg:grid-cols-2">
      <div class="order-2 lg:order-1 flex items-center">
        <div class="px-5 sm:px-10 lg:pl-[max(1.25rem,calc((100vw-1200px)/2))] lg:pr-16 py-14 md:py-20 max-w-2xl">
          <p class="font-display text-[0.7rem] font-bold uppercase tracking-[0.26em] text-brass-600 mb-3">
            Why people call us back
          </p>
          <h2 class="display text-navy-900 text-3xl md:text-[2.5rem] leading-[1.06]">
            Everything on the van.<br />
            Everything quoted first.
          </h2>

          <div class="mt-6 space-y-4 text-muted leading-relaxed">
            <p>
              Most locksmith trouble is the same story: nobody tells you what it
              costs until the work is done. We do it the other way round — you get
              the number on the phone, and that is the number on the invoice.
            </p>
            <p>
              The van carries the cylinders, blanks, programming gear and cutting
              machines, so the majority of jobs are finished on the first visit
              rather than turning into a second appointment for a part.
            </p>
            <p>
              Fifteen years around the same streets teaches you the housing stock —
              the jimmy-proof locks on Brooklyn apartment doors, the prewar mortise
              sets in the brownstones, the salt-eaten hardware along the Belt and
              the Staten Island shore.
            </p>
          </div>

          <dl class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-x-5 gap-y-6">
            {[
              { v: '20–30', k: 'min in Brooklyn' },
              { v: '7am–11pm', k: 'every day' },
              { v: '105', k: 'neighborhoods' },
              { v: '5.0', k: 'on Google' },
            ].map((x) => (
              <div class="reveal">
                <dt class="display text-navy-900 text-[1.6rem] leading-none">{x.v}</dt>
                <dd class="mt-1.5 text-[0.72rem] uppercase tracking-[0.13em] text-muted leading-tight">{x.k}</dd>
              </div>
            ))}
          </dl>

          <div class="mt-8 flex flex-wrap gap-3">
            <a href={`tel:${business.phoneHref}`} class="btn btn-brass" data-call-cta="whyus">
              <Icon name="phone" size={18} />
              {business.phoneDisplay}
            </a>
            <a href="/about/" class="btn btn-outline">
              More about us
              <Icon name="arrow" size={17} />
            </a>
          </div>
        </div>
      </div>

      <div class="order-1 lg:order-2 relative min-h-[16rem] lg:min-h-[36rem]">
        <img
          src="/work/brass-deadbolt-and-knob.webp"
          srcset="/work/brass-deadbolt-and-knob-800.webp 800w, /work/brass-deadbolt-and-knob.webp 1200w"
          sizes="(min-width: 1024px) 50vw, 100vw"
          alt="A brass deadbolt and matching knob fitted to a wooden front door in Brooklyn"
          width="1200" height="1600"
          class="absolute inset-0 w-full h-full object-cover"
          loading="lazy" decoding="async"
        />
      </div>
    </div>
  </section>

  <!-- ══════════════ 06 · COVERAGE — text index, not cards ══════════════ -->
  <section class="relative overflow-hidden py-16 md:py-22 bg-cream" id="areas">
    <Backdrop variant="pins" tone="light" intensity={0.7} />
    <div class="container-x relative z-[1]">
      <div class="mb-10 pb-6 border-b-2 border-navy-900">
        <p class="font-display text-[0.7rem] font-bold uppercase tracking-[0.26em] text-brass-600 mb-3">
          Where we work
        </p>
        <h2 class="display text-navy-900 text-3xl md:text-[2.7rem] max-w-3xl">
          Every neighborhood in Brooklyn and Staten Island
        </h2>
      </div>

      <div class="grid md:grid-cols-2 gap-10 md:gap-14">
        {[
          { region: 'Brooklyn', areas: brooklynAreas },
          { region: 'Staten Island', areas: siAreas },
        ].map((group) => (
          <div>
            <h3 class="flex items-baseline justify-between gap-4 pb-3 mb-4 border-b border-line">
              <span class="display text-navy-900 text-xl">{group.region}</span>
              <span class="text-muted text-sm tabular-nums">{group.areas.length} covered</span>
            </h3>
            <ul class="columns-2 gap-6 text-[0.92rem]">
              {group.areas.map((a) => (
                <li class="mb-1.5 break-inside-avoid">
                  <a href={`/service-areas/${a.slug}/`} class="text-navy-800 hover:text-brass-600 hover:underline underline-offset-2 transition-colors">
                    {a.name}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <FaqAccordion faqs={homeFaqs} heading="Straight answers before you call" />

  <CoverageMap
    heading="Where we work"
    intro="Every Brooklyn and Staten Island neighborhood we cover, with the drive time from our Bay Ridge base. Tap a pin for that neighborhood's page."
  />


  <CtaBand />
</BaseLayout>

<style>
  /* ── Hero light: three large, heavily blurred orbs drifting very slowly.
     Transform-only animation, so it runs on the compositor and costs no
     layout. Kept behind everything (z -1 inside the isolated section). */
  .hero-aurora { position: absolute; inset: 0; z-index: -1; pointer-events: none; }
  .hero-aurora::after {
    /* gentle fade into the photo strip below */
    content: ''; position: absolute; inset: auto 0 0 0; height: 30%;
    background: linear-gradient(to bottom, transparent, rgb(16 35 48 / 0.9));
  }
  .orb { position: absolute; border-radius: 9999px; filter: blur(70px); will-change: transform; }
  .orb-a { width: 46rem; height: 46rem; right: -12rem; top: -14rem; background: rgb(56 110 134 / 0.55); animation: drift-a 26s ease-in-out infinite alternate; }
  .orb-b { width: 30rem; height: 30rem; left: -10rem; bottom: -12rem; background: rgb(43 85 104 / 0.6); animation: drift-b 32s ease-in-out infinite alternate; }
  .orb-c { width: 22rem; height: 22rem; right: 22%; bottom: -8rem; background: rgb(231 181 76 / 0.16); animation: drift-c 22s ease-in-out infinite alternate; }
  @keyframes drift-a { to { transform: translate3d(-8rem, 6rem, 0) scale(1.08); } }
  @keyframes drift-b { to { transform: translate3d(9rem, -5rem, 0) scale(1.12); } }
  @keyframes drift-c { to { transform: translate3d(-10rem, -6rem, 0) scale(0.92); } }

  /* ── Live hours pill */
  .hero-pill {
    display: inline-flex; flex-wrap: wrap; align-items: center; gap: 0.5rem;
    padding: 0.4rem 0.9rem; border-radius: 9999px;
    background: rgb(255 255 255 / 0.07); border: 1px solid rgb(255 255 255 / 0.14);
    color: var(--color-navy-100, #e3edf1); font-size: 0.82rem; font-weight: 600;
    backdrop-filter: blur(6px);
  }
  .hero-dot { position: relative; width: 0.5rem; height: 0.5rem; border-radius: 9999px; background: var(--color-brass-400); }
  .hero-pill.is-open .hero-dot { background: #4ade80; }
  .hero-pill.is-open .hero-dot::after {
    content: ''; position: absolute; inset: 0; border-radius: inherit; background: #4ade80;
    animation: ping 1.8s cubic-bezier(0, 0, 0.2, 1) infinite;
  }
  .hero-pill.is-closed .hero-dot { background: var(--color-navy-300); }
  @keyframes ping { 75%, 100% { transform: scale(2.6); opacity: 0; } }

  /* ── Underline that draws itself under "already calls." */
  .hero-underline { position: relative; white-space: nowrap; }
  .hero-underline svg {
    position: absolute; left: 0; right: 0; bottom: -0.32em; width: 100%; height: 0.38em; overflow: visible;
  }
  .hero-underline path {
    fill: none; stroke: var(--color-brass-400); stroke-width: 5; stroke-linecap: round;
    stroke-dasharray: 320; stroke-dashoffset: 320;
    animation: draw 1.1s 0.55s cubic-bezier(0.65, 0, 0.35, 1) forwards;
  }
  @keyframes draw { to { stroke-dashoffset: 0; } }

  /* ── Trust chips */
  .hero-chip {
    display: inline-flex; align-items: center; gap: 0.45rem;
    padding: 0.45rem 0.85rem; border-radius: 0.6rem;
    background: rgb(255 255 255 / 0.05); border: 1px solid rgb(255 255 255 / 0.1);
    color: var(--color-navy-100, #e3edf1);
  }

  /* ── Form: soft glow behind, gentle rise on load */
  .hero-form { animation: rise 0.8s 0.15s cubic-bezier(0.22, 1, 0.36, 1) both; }
  .hero-form > :global(form) { position: relative; }
  .hero-glow {
    position: absolute; inset: -1.75rem; border-radius: 2rem; z-index: -1;
    background: radial-gradient(60% 60% at 50% 45%, rgb(231 181 76 / 0.28), rgb(56 110 134 / 0.18) 55%, transparent 75%);
    filter: blur(24px);
    animation: breathe 7s ease-in-out infinite alternate;
  }
  @keyframes breathe { from { opacity: 0.65; transform: scale(0.97); } to { opacity: 1; transform: scale(1.03); } }
  @keyframes rise { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }

  .hero-cta { box-shadow: 0 14px 30px -12px rgb(231 181 76 / 0.55); }

  @media (prefers-reduced-motion: reduce) {
    .orb, .hero-glow, .hero-form, .hero-pill .hero-dot::after { animation: none; }
    .hero-underline path { animation: none; stroke-dashoffset: 0; }
