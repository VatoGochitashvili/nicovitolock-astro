---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import HeroBg from '@/components/HeroBg.astro';
import TrustBar from '@/components/TrustBar.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import Reviews from '@/components/Reviews.astro';
import CtaBand from '@/components/CtaBand.astro';
import FaqAccordion from '@/components/FaqAccordion.astro';
import { business } from '@/data/business';
import { services, featuredServices } from '@/data/services';
import { serviceAreas } from '@/data/locations';
import { localBusinessSchema, webSiteSchema, organizationSchema, faqSchema } from '@/lib/seo';

const brooklynAreas = serviceAreas.filter((a) => a.region === 'Brooklyn');
const siAreas = serviceAreas.filter((a) => a.region === 'Staten Island');

const homeFaqs = [
  {
    q: 'Are you open 24 hours?',
    a: "No, and we'd rather say so plainly. We're open every day from 7 AM to 11 PM, weekends and holidays included. Plenty of locksmiths advertise 24/7 and then don't answer at 3 AM — we tell you our real hours so you know exactly when you can reach a person.",
  },
  {
    q: 'What areas do you cover?',
    a: `All of Brooklyn and all of Staten Island — ${serviceAreas.length} neighborhoods in total. We're based in Bay Ridge, so southwest Brooklyn is fastest, and Staten Island is a straight run over the Verrazzano.`,
  },
  {
    q: 'How much does a locksmith cost?',
    a: "It depends on the job, which is why we quote before we come out rather than after. A house lockout starts around $49, a rekey around $25 per cylinder, and a car key around $120. You get the number on the phone and we honor it — no bait price that triples at the door.",
  },
  {
    q: 'How fast can you get here?',
    a: "Most Brooklyn calls we reach in 20–30 minutes. Staten Island typically runs 30–45 depending on where you are and what the bridge looks like. We give you a real window when you call, not a vague 'on our way.'",
  },
  {
    q: 'Are you licensed and insured?',
    a: "Yes. We're a licensed and insured New York locksmith. Ask to see credentials when we arrive — any legitimate locksmith will have them on hand, and you should be suspicious of one who doesn't.",
  },
  {
    q: 'Will you damage my lock getting me in?',
    a: "Almost never. We pick or bypass in the large majority of lockouts, which leaves your existing lock fully usable. Drilling is a last resort, and if it's genuinely necessary we tell you and quote the replacement before touching the door.",
  },
];

const schema = [
  localBusinessSchema(),
  webSiteSchema(),
  organizationSchema(),
  faqSchema(homeFaqs),
];

const title = 'Locksmith Brooklyn & Staten Island | Nico & Vito';
const description =
  'Licensed Bay Ridge locksmith covering all of Brooklyn & Staten Island. Lockouts, rekeys, car keys, intercoms, cameras. Open daily 7AM–11PM. (347) 613-0218.';

const steps = [
  { n: '01', t: 'Call and describe it', d: 'Tell us the door, the lock, or the car. We ask the questions that let us quote it accurately over the phone.' },
  { n: '02', t: 'Get a real price', d: 'You hear the number before we leave Bay Ridge. No trip fee surprises, no "we’ll see when we get there."' },
  { n: '03', t: 'We show up prepared', d: 'A licensed tech arrives in the window we gave you with the parts and tools already on the van.' },
  { n: '04', t: 'Job done, door works', d: 'We finish, test the door, clean up, and charge the price we quoted. That’s the whole thing.' },
];
---

<BaseLayout title={title} description={description} schema={schema} canonical="/">
  <!-- ================= HERO ================= -->
  <!-- Full-bleed Bay Ridge row houses, dimmed. No competing image card —
       the neighborhood IS the picture, the copy sits on the dark left. -->
  <section class="relative tex-navy overflow-hidden">
    <HeroBg variant="neighborhood" strength={42} />

    <div class="container-x relative py-20 md:py-28 lg:py-36">
      <div class="max-w-2xl">
        <p class="eyebrow eyebrow--light mb-5">Bay Ridge, Brooklyn</p>

        <h1 class="display text-white text-[2.6rem] sm:text-[3.4rem] lg:text-[4.25rem] leading-[1.02]">
          Locked out in Brooklyn?<br />
          <span class="text-brass-400">We're a few blocks away.</span>
        </h1>

        <p class="mt-6 text-navy-100 text-lg md:text-xl leading-relaxed max-w-xl">
          A licensed, family-run locksmith based in Bay Ridge — covering every
          neighborhood in <strong class="text-white font-semibold">Brooklyn</strong> and
          <strong class="text-white font-semibold">Staten Island</strong>.
          Priced before we start.
        </p>

        <div class="mt-9 flex flex-col sm:flex-row gap-3">
          <a href={`tel:${business.phoneHref}`} class="btn btn-brass btn-lg" data-call-cta="hero-primary">
            <Icon name="phone" size={20} />
            {business.phoneDisplay}
          </a>
          <a href="/contact" class="btn btn-ghost btn-lg">Request a quote</a>
        </div>

        <ul class="mt-10 flex flex-wrap gap-x-8 gap-y-3 text-[0.92rem]">
          {[
            { i: 'clock', t: 'Open daily 7 AM – 11 PM' },
            { i: 'badge', t: 'Licensed & insured' },
            { i: 'bolt',  t: '20–30 min typical arrival' },
          ].map((x) => (
            <li class="flex items-center gap-2 text-navy-100">
              <Icon name={x.i} size={16} class="text-brass-400 shrink-0" />
              {x.t}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <TrustBar />

  <!-- ================= NOT 24/7 — honesty as a differentiator ================= -->
  <section class="bg-white border-b border-line-cool">
    <div class="container-x py-7 flex flex-col sm:flex-row items-center justify-center gap-4 text-center sm:text-left">
      <span class="w-10 h-10 rounded-full bg-brass-50 text-brass-600 grid place-items-center shrink-0">
        <Icon name="clock" size={20} />
      </span>
      <p class="text-navy-800 text-[1.02rem] max-w-3xl">
        We're not a 24/7 operation — we're open <strong class="text-navy-900">every day, 7 AM to 11 PM</strong>.
        <span class="text-muted">When you call in those hours, a locksmith actually answers.</span>
      </p>
    </div>
  </section>

  <!-- ================= SERVICES ================= -->
  <section class="py-16 md:py-22 bg-cream" id="services">
    <div class="container-x">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-5 mb-10">
        <div class="max-w-2xl">
          <p class="eyebrow mb-3">What we do</p>
          <h2 class="display text-navy-900 text-3xl md:text-[2.8rem]">
            Locks, keys, and security — one local shop
          </h2>
          <p class="mt-4 text-muted text-lg leading-relaxed">
            Residential, automotive, and commercial work across Brooklyn and Staten Island.
            If it locks, opens, buzzes, or records, it's on this list.
          </p>
        </div>
        <a href="/services" class="btn btn-outline shrink-0">
          All {services.length} services
          <Icon name="arrow" size={17} />
        </a>
      </div>

      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {featuredServices.map((s, i) => <ServiceCard service={s} delay={i * 60} />)}
      </div>

      <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {services.filter((s) => !s.featured).map((s, i) => (
          <a
            href={`/services/${s.slug}`}
            class="card card-hover px-5 py-4 flex items-center gap-3.5 reveal"
            data-delay={i * 40}
          >
            <span class="w-9 h-9 rounded-lg bg-navy-50 text-navy-700 grid place-items-center shrink-0">
              <Icon name={s.icon} size={19} />
            </span>
            <span class="font-display font-bold text-navy-900 text-[0.98rem] leading-tight">{s.name}</span>
            <Icon name="arrow" size={16} class="text-brass-500 ml-auto shrink-0" />
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ================= LOCAL STORY ================= -->
  <section class="py-16 md:py-22 tex-stone">
    <div class="container-x grid lg:grid-cols-12 gap-10 lg:gap-14 items-center">
      <div class="lg:col-span-5 reveal" data-reveal="left">
        <div class="frame">
          <img
            src="/brand/van-open.jpg"
            alt="Nico & Vito Locksmith service van with the side door open, key board and key cutting machines visible inside"
            width="1200" height="800"
            class="w-full aspect-[4/3] object-cover"
            loading="lazy"
          />
        </div>
      </div>

      <div class="lg:col-span-7">
        <p class="eyebrow mb-3">Who you're calling</p>
        <h2 class="display text-navy-900 text-3xl md:text-[2.6rem]">
          A Bay Ridge shop, not a call center
        </h2>

        <div class="mt-5 space-y-4 text-muted text-[1.05rem] leading-relaxed">
          <p>
            When you call a lot of "locksmiths" in New York, you reach a national dispatch
            office that sells your job to whoever bids on it. You get quoted $29 on the
            phone and handed a $350 invoice at the door, by someone who has never worked
            on your kind of lock.
          </p>
          <p>
            <strong class="text-navy-900">That's not us.</strong> Nico &amp; Vito is based in
            Bay Ridge. The number on this page rings the same people who show up at your
            door. We quote the price before we leave, and it's the price you pay.
          </p>
          <p>
            Working out of one neighborhood for years means we know the housing stock —
            the jimmy-proof locks on Brooklyn apartment doors, the prewar mortise sets in
            Park Slope brownstones, the salt-corroded hardware along the Belt, the
            multi-family intercoms in Borough Park. That's why most of our jobs finish
            on the first visit.
          </p>
        </div>

        <div class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-4">
          {business.highlights.map((h) => (
            <div class="bg-white rounded-lg border border-line px-4 py-3.5">
              <p class="display text-navy-900 text-[1.35rem] leading-none">{h.value}</p>
              <p class="mt-1.5 text-xs font-semibold uppercase tracking-wider text-muted leading-tight">
                {h.label}
              </p>
            </div>
          ))}
        </div>

        <a href="/about" class="btn btn-navy mt-8">
          More about us
          <Icon name="arrow" size={17} />
        </a>
      </div>
    </div>
  </section>

  <!-- ================= HOW IT WORKS ================= -->
  <section class="py-16 md:py-20 tex-navy">
    <div class="container-x">
      <div class="max-w-2xl mb-10">
        <p class="eyebrow eyebrow--light mb-3">How it works</p>
        <h2 class="display text-white text-3xl md:text-[2.6rem]">
          Four steps, no surprises
        </h2>
      </div>
      <ol class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {steps.map((s, i) => (
          <li class="bg-white/5 border border-white/10 rounded-xl p-6 reveal" data-delay={i * 70}>
            <span class="display text-brass-400 text-2xl">{s.n}</span>
            <h3 class="mt-2 text-white text-lg">{s.t}</h3>
            <p class="mt-2 text-navy-200 text-[0.93rem] leading-relaxed">{s.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ================= SERVICE AREAS ================= -->
  <section class="py-16 md:py-22 bg-cream" id="areas">
    <div class="container-x">
      <div class="max-w-2xl mb-9">
        <p class="eyebrow mb-3">Where we work</p>
        <h2 class="display text-navy-900 text-3xl md:text-[2.8rem]">
          Every neighborhood in Brooklyn &amp; Staten Island
        </h2>
        <p class="mt-4 text-muted text-lg leading-relaxed">
          {serviceAreas.length} neighborhoods, one local shop. Bay Ridge is home, so
          southwest Brooklyn is minutes away — and Staten Island is a straight run
          over the Verrazzano.
        </p>
      </div>

      <div class="grid lg:grid-cols-2 gap-6">
        {[
          { region: 'Brooklyn', areas: brooklynAreas, note: 'Our home borough — from the Narrows to the Queens line.' },
          { region: 'Staten Island', areas: siAreas, note: 'Straight over the Verrazzano — North Shore to Tottenville.' },
        ].map((group, gi) => (
          <div class="card p-6 md:p-7 reveal" data-delay={gi * 100}>
            <div class="flex items-center gap-3">
              <span class="w-10 h-10 rounded-lg bg-navy-800 text-brass-400 grid place-items-center shrink-0">
                <Icon name="pin" size={21} />
              </span>
              <div>
                <h3 class="text-xl text-navy-900 leading-tight">{group.region}</h3>
                <p class="text-sm text-muted">{group.areas.length} neighborhoods covered</p>
              </div>
            </div>
            <p class="mt-3 text-muted text-[0.95rem]">{group.note}</p>
            <ul class="mt-4 flex flex-wrap gap-2">
              {group.areas.map((a) => (
                <li>
                  <a
                    href={`/service-areas/${a.slug}`}
                    class="inline-block px-2.5 py-1 rounded-md bg-cream-deep border border-line text-[0.83rem] text-navy-800 hover:bg-brass-400 hover:border-brass-400 hover:text-navy-950 transition-colors"
                  >{a.name}</a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <div class="mt-7 text-center">
        <a href="/service-areas" class="btn btn-outline">
          Browse all service areas
          <Icon name="arrow" size={17} />
        </a>
      </div>
    </div>
  </section>

  <Reviews />

  <!-- ================= BRANDS ================= -->
  <section class="py-12 bg-white border-y border-line-cool overflow-hidden">
    <div class="container-x mb-6">
      <p class="text-center text-muted text-[0.72rem] font-bold uppercase tracking-[0.2em]">
        Hardware we install &amp; service
      </p>
    </div>
    <div class="marquee-mask">
      <div class="marquee">
        {[...business.brands, ...business.brands].map((b) => (
          <span class="font-display font-bold text-lg md:text-xl text-navy-300 whitespace-nowrap select-none">
            {b}
          </span>
        ))}
      </div>
    </div>
  </section>

  <FaqAccordion faqs={homeFaqs} heading="Straight answers before you call" />

  <CtaBand />
</BaseLayout>
