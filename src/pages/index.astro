---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import Backdrop from '@/components/Backdrop.astro';
import ContactForm from '@/components/ContactForm.astro';
import CtaBand from '@/components/CtaBand.astro';
import FaqAccordion from '@/components/FaqAccordion.astro';
import { business } from '@/data/business';
import { services } from '@/data/services';
import { serviceAreas } from '@/data/locations';
import { localBusinessSchema, webSiteSchema, organizationSchema, faqSchema } from '@/lib/seo';

const brooklynAreas = serviceAreas.filter((a) => a.region === 'Brooklyn');
const siAreas = serviceAreas.filter((a) => a.region === 'Staten Island');
const priced = services.filter((s) => s.priceFrom?.startsWith('$'));

const homeFaqs = [
  {
    q: 'Are you open 24 hours?',
    a: "No, and we'd rather say so plainly. We're open every day from 7 AM to 11 PM, weekends and holidays included. Plenty of locksmiths advertise 24/7 and then don't answer at 3 AM — we tell you our real hours so you know exactly when you can reach a person.",
  },
  {
    q: 'What areas do you cover?',
    a: `All of Brooklyn and all of Staten Island — ${serviceAreas.length} neighborhoods in total. We're based in Bay Ridge, so southwest Brooklyn is fastest, and Staten Island is a straight run over the Verrazzano.`,
  },
  {
    q: 'How much does a locksmith cost?',
    a: "It depends on the job, which is why we quote before we come out rather than after. A house lockout starts around $49, a rekey around $25 per cylinder, and a car key around $120. You get the number on the phone and we honor it — no bait price that triples at the door.",
  },
  {
    q: 'How fast can you get here?',
    a: "Most Brooklyn calls we reach in 20–30 minutes. Staten Island typically runs 30–45 depending on where you are and what the bridge looks like. We give you a real window when you call, not a vague 'on our way.'",
  },
  {
    q: 'Are you licensed and insured?',
    a: "Yes. We're a licensed and insured New York locksmith. Ask to see credentials when we arrive — any legitimate locksmith will have them on hand, and you should be suspicious of one who doesn't.",
  },
  {
    q: 'Will you damage my lock getting me in?',
    a: "Almost never. We pick or bypass in the large majority of lockouts, which leaves your existing lock fully usable. Drilling is a last resort, and if it's genuinely necessary we tell you and quote the replacement before touching the door.",
  },
];

const schema = [localBusinessSchema(), webSiteSchema(), organizationSchema(), faqSchema(homeFaqs)];

const title = 'Locksmith Brooklyn & Staten Island | Nico & Vito';
const description =
  'Licensed Bay Ridge locksmith covering all of Brooklyn & Staten Island. Lockouts, rekeys, car keys, intercoms, cameras. Open daily 7AM–11PM. (347) 613-0218.';
---

<BaseLayout title={title} description={description} schema={schema} canonical="/">

  <!-- ══════════════ 01 · HERO ══════════════
       Flat navy plate, no photograph behind the type. The form is the only
       light object in the band, which makes it the focal point. -->
  <section class="relative bg-navy-900 overflow-hidden">
    <Backdrop variant="bitting" tone="dark" intensity={1.2} />
    <div class="absolute inset-x-0 top-0 h-1 bg-brass-400 z-[1]" aria-hidden="true"></div>
    <span
      class="pointer-events-none select-none absolute -left-6 bottom-[-3rem] display text-white/[0.035] text-[13rem] lg:text-[20rem] leading-none"
      aria-hidden="true">11209</span>

    <div class="container-x relative z-[1] py-12 md:py-16 lg:py-20">
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-x-16 lg:gap-y-8 lg:items-center">

        <div class="lg:col-span-7 lg:col-start-1 lg:row-start-1">
          <p class="flex items-center gap-3 font-display text-[0.7rem] font-bold uppercase tracking-[0.26em] text-brass-400 mb-5">
            <span class="w-8 h-px bg-brass-400"></span>
            Bay Ridge · Brooklyn · Staten Island
          </p>

          <h1 class="display text-white text-[2.3rem] sm:text-[3rem] lg:text-[3.7rem] leading-[1.02]">
            The locksmith your<br class="hidden sm:block" />
            block already calls.
          </h1>

          <p class="mt-6 text-navy-200 text-lg md:text-xl leading-relaxed max-w-xl">
            Licensed, family-run, and working out of Bay Ridge — lockouts, lock changes,
            car keys, intercoms and cameras across every Brooklyn and Staten Island
            neighborhood. Price agreed before we start.
          </p>
        </div>

        <div class="lg:col-span-5 lg:col-start-8 lg:row-start-1 lg:row-span-2">
          <ContactForm variant="short" tone="dark" />
        </div>

        <div class="lg:col-span-7 lg:col-start-1 lg:row-start-2">
          <a href={`tel:${business.phoneHref}`} class="btn btn-brass btn-lg w-full sm:w-auto" data-call-cta="hero-primary">
            <Icon name="phone" size={20} />
            {business.phoneDisplay}
          </a>
          <dl class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-x-6 gap-y-5 border-t border-white/10 pt-6">
            {[
              { k: 'Open daily', v: '7am–11pm' },
              { k: 'Brooklyn arrival', v: '20–30 min' },
              { k: 'Neighborhoods', v: String(serviceAreas.length) },
              { k: 'Licensed & insured', v: 'Yes' },
            ].map((x) => (
              <div>
                <dt class="text-[0.68rem] uppercase tracking-[0.14em] text-navy-300">{x.k}</dt>
                <dd class="display text-brass-400 text-[1.35rem] mt-1">{x.v}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════ 02 · HOURS HONESTY ══════════════ -->
  <section class="bg-white border-b border-line-cool">
    <div class="container-x py-5 flex flex-col sm:flex-row items-center justify-center gap-3 text-center sm:text-left">
      <Icon name="clock" size={19} class="text-brass-600 shrink-0" />
      <p class="text-navy-800 text-[0.98rem]">
        Not a 24/7 operation — open <strong class="text-navy-900">every day, 7 AM to 11 PM</strong>.
        <span class="text-muted">Inside those hours a locksmith actually answers the phone.</span>
      </p>
    </div>
  </section>

  <!-- ══════════════ 03 · SERVICES — numbered index, not a card grid ══════════════ -->
  <section class="relative overflow-hidden py-16 md:py-22 bg-cream" id="services">
    <Backdrop variant="grid" tone="light" intensity={0.8} />
    <div class="container-x relative z-[1]">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-5 mb-10 pb-6 border-b-2 border-navy-900">
        <div>
          <p class="font-display text-[0.7rem] font-bold uppercase tracking-[0.26em] text-brass-600 mb-3">
            What we do
          </p>
          <h2 class="display text-navy-900 text-3xl md:text-[2.7rem] max-w-2xl">
            Twelve services, one local shop
          </h2>
        </div>
        <a href="/pricing" class="text-navy-900 font-semibold border-b-2 border-brass-400 pb-0.5 shrink-0 hover:text-brass-600 transition-colors">
          See starting prices →
        </a>
      </div>

      <ol class="divide-y divide-line">
        {services.map((s, i) => (
          <li>
            <a
              href={`/services/${s.slug}`}
              class="group grid grid-cols-[2.75rem_1fr_auto] md:grid-cols-[4rem_18rem_1fr_auto] items-baseline gap-x-4 md:gap-x-8 py-5 md:py-6 hover:bg-white transition-colors"
            >
              <span class="font-display font-bold text-[0.85rem] text-brass-500 tabular-nums">
                {String(i + 1).padStart(2, '0')}
              </span>
              <span class="font-display font-bold text-navy-900 text-[1.15rem] md:text-[1.3rem] leading-tight group-hover:text-brass-600 transition-colors">
                {s.name}
              </span>
              <span class="col-span-2 md:col-span-1 text-muted text-[0.95rem] leading-relaxed mt-1.5 md:mt-0">
                {s.summary}
              </span>
              <span class="hidden md:block text-brass-500 self-center">
                <Icon name="arrow" size={18} />
              </span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ══════════════ 04 · PRICE PREVIEW ══════════════ -->
  <section class="relative overflow-hidden py-16 md:py-20 bg-navy-900">
    <Backdrop variant="rings" tone="dark" />
    <div class="container-x relative z-[1] grid lg:grid-cols-12 gap-10 lg:gap-16">
      <div class="lg:col-span-5">
        <p class="font-display text-[0.7rem] font-bold uppercase tracking-[0.26em] text-brass-400 mb-3">
          Straight pricing
        </p>
        <h2 class="display text-white text-3xl md:text-[2.5rem]">
          Published, so you can hold us to it
        </h2>
        <p class="mt-5 text-navy-200 leading-relaxed">
          The $19 and $29 lockout quotes you see elsewhere are a hook — the tech
          arrives, calls your lock "high security," drills it, and hands you a bill
          for several hundred. These are the real starting numbers. Your exact price
          is quoted on the phone before we leave.
        </p>
        <a href="/pricing" class="btn btn-brass mt-7">
          Full price list
          <Icon name="arrow" size={17} />
        </a>
      </div>

      <div class="lg:col-span-7">
        <dl class="divide-y divide-white/10 border-y border-white/10">
          {priced.map((s) => (
            <div class="flex items-baseline justify-between gap-6 py-4">
              <dt>
                <a href={`/services/${s.slug}`} class="text-white font-semibold hover:text-brass-300 transition-colors">
                  {s.name}
                </a>
              </dt>
              <dd class="display text-brass-400 text-xl whitespace-nowrap">{s.priceFrom}</dd>
            </div>
          ))}
        </dl>
        <p class="mt-4 text-navy-300 text-sm">
          Starting points for standard hardware. Nothing here is a binding quote —
          yours comes on the phone, before we roll out.
        </p>
      </div>
    </div>
  </section>

  <!-- ══════════════ 05 · THE VAN — hard-edged split, no overlay ══════════════ -->
  <section class="bg-cream-deep">
    <div class="grid lg:grid-cols-2">
      <div class="order-2 lg:order-1 flex items-center">
        <div class="px-5 sm:px-10 lg:pl-[max(1.25rem,calc((100vw-1200px)/2))] lg:pr-16 py-14 md:py-20 max-w-2xl">
          <p class="font-display text-[0.7rem] font-bold uppercase tracking-[0.26em] text-brass-600 mb-3">
            Who you're calling
          </p>
          <h2 class="display text-navy-900 text-3xl md:text-[2.5rem]">
            A Bay Ridge shop, not a call center
          </h2>
          <div class="mt-5 space-y-4 text-muted leading-relaxed">
            <p>
              Search "locksmith near me" in New York and most of what you get is a
              national dispatch office that auctions your job to whoever bids. The
              $29 phone quote becomes a $350 invoice at your door.
            </p>
            <p>
              <strong class="text-navy-900">The number on this page rings us.</strong>
              The same people who answer it are the ones who show up. No dispatcher,
              no subcontractor, no handoff.
            </p>
            <p>
              Working one neighborhood for years teaches you the housing stock — the
              jimmy-proof locks on Brooklyn apartment doors, the prewar mortise sets in
              brownstones, the salt-corroded hardware along the Belt and the Staten
              Island shore. It's why most of our jobs finish on the first visit.
            </p>
          </div>
          <a href="/about" class="btn btn-navy mt-8">
            More about us
            <Icon name="arrow" size={17} />
          </a>
        </div>
      </div>

      <div class="order-1 lg:order-2 relative min-h-[18rem] lg:min-h-[34rem]">
        <img
          src="/brand/van-2.jpg"
          alt="The Nico & Vito Locksmith van open on a Brooklyn street, showing the key board, cutting machines, and programming equipment"
          width="1200" height="800"
          class="absolute inset-0 w-full h-full object-cover"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- ══════════════ 06 · COVERAGE — text index, not cards ══════════════ -->
  <section class="relative overflow-hidden py-16 md:py-22 bg-cream" id="areas">
    <Backdrop variant="pins" tone="light" intensity={0.7} />
    <div class="container-x relative z-[1]">
      <div class="mb-10 pb-6 border-b-2 border-navy-900">
        <p class="font-display text-[0.7rem] font-bold uppercase tracking-[0.26em] text-brass-600 mb-3">
          Where we work
        </p>
        <h2 class="display text-navy-900 text-3xl md:text-[2.7rem] max-w-3xl">
          Every neighborhood in Brooklyn and Staten Island
        </h2>
      </div>

      <div class="grid md:grid-cols-2 gap-10 md:gap-14">
        {[
          { region: 'Brooklyn', areas: brooklynAreas },
          { region: 'Staten Island', areas: siAreas },
        ].map((group) => (
          <div>
            <h3 class="flex items-baseline justify-between gap-4 pb-3 mb-4 border-b border-line">
              <span class="display text-navy-900 text-xl">{group.region}</span>
              <span class="text-muted text-sm tabular-nums">{group.areas.length} covered</span>
            </h3>
            <ul class="columns-2 gap-6 text-[0.92rem]">
              {group.areas.map((a) => (
                <li class="mb-1.5 break-inside-avoid">
                  <a href={`/service-areas/${a.slug}`} class="text-navy-800 hover:text-brass-600 hover:underline underline-offset-2 transition-colors">
                    {a.name}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <FaqAccordion faqs={homeFaqs} heading="Straight answers before you call" />

  <CtaBand />
</BaseLayout>
