---
/**
 * /videos/ — the "watch page" for our YouTube videos.
 *
 * Google only shows video results for pages where the video is the main
 * content, so the newest video sits at the top here with its own title,
 * description and VideoObject schema. The homepage and About page embed the
 * same video but point here.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import CtaBand from '@/components/CtaBand.astro';
import Icon from '@/components/Icon.astro';
import YouTubeVideo from '@/components/YouTubeVideo.astro';
import { videos, videoSchema, youtubeWatch } from '@/data/videos';
import { business } from '@/data/business';
import { breadcrumbSchema, localBusinessSchema } from '@/lib/seo';

const SITE = 'https://nicovitolocksmith.com';
const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Videos', url: '/videos/' },
];
const [main, ...rest] = videos;
const title = 'Locksmith Videos | Nico & Vito Locksmith, Brooklyn & Staten Island';
const description =
  'Watch Nico & Vito Locksmith at work: lockouts, car keys cut and programmed at the car, lock changes, smart locks and commercial doors in Brooklyn and Staten Island.';

const services = [
  { href: '/services/emergency-lockout-service/', label: 'Lockouts' },
  { href: '/services/car-key-replacement/', label: 'Car key replacement' },
  { href: '/services/key-fob-and-remote-programming/', label: 'Key fob programming' },
  { href: '/services/lock-rekeying/', label: 'Lock rekeying' },
  { href: '/services/smart-lock-installation/', label: 'Smart locks' },
  { href: '/services/commercial-locksmith/', label: 'Commercial doors' },
];
---
<BaseLayout
  title={title}
  description={description}
  canonical="/videos"
  schema={[breadcrumbSchema(crumbs), localBusinessSchema(), ...videos.map((v) => videoSchema(v, `${SITE}/videos/`))]}
>
  <PageHero
    eyebrow="Real jobs · no stock footage"
    title="Videos"
    subtitle="See how we work, from lockouts to car keys cut and programmed at the car."
    crumbs={crumbs}
    ghost="VIDEO"
  />

  {main && (
    <section class="py-14 md:py-18 bg-cream">
      <div class="container-x max-w-5xl">
        <YouTubeVideo video={main} />
        <h2 class="mt-8 display text-navy-900 text-2xl md:text-[2.1rem]">{main.title}</h2>
        <p class="mt-4 text-navy-800 leading-relaxed text-[1.05rem] max-w-3xl">{main.description}</p>

        <div class="mt-8 grid md:grid-cols-2 gap-8">
          <div>
            <h3 class="font-display font-bold text-navy-900 text-lg">In this video</h3>
            <ul class="mt-3 space-y-2 text-navy-800">
              <li>Getting back in after a lockout, with the lock picked open</li>
              <li>A new car key cut on the machine in our van</li>
              <li>Keys and smart fobs programmed right at the car</li>
              <li>Lock changes, deadbolts and smart locks on front doors</li>
              <li>Panic bars and door closers for businesses</li>
            </ul>
          </div>
          <div>
            <h3 class="font-display font-bold text-navy-900 text-lg">The services behind it</h3>
            <ul class="mt-3 flex flex-wrap gap-2">
              {services.map((s) => (
                <li><a href={s.href} class="inline-block rounded-full border border-line bg-white px-4 py-2 text-[0.95rem] text-navy-900 hover:border-navy-900 transition-colors">{s.label}</a></li>
              ))}
            </ul>
          </div>
        </div>

        <div class="mt-9 flex flex-wrap gap-3">
          <a href={`tel:${business.phoneHref}`} class="btn btn-brass"><Icon name="phone" size={18} /> {business.phoneDisplay}</a>
          {business.social.youtube && (
            <a href={business.social.youtube} target="_blank" rel="noopener" class="btn btn-outline"><Icon name="youtube" size={18} /> Subscribe on YouTube</a>
          )}
          <a href={youtubeWatch(main.id)} target="_blank" rel="noopener" class="btn btn-outline">Watch on YouTube</a>
        </div>
      </div>
    </section>
  )}

  {rest.length > 0 && (
    <section class="py-14 bg-white">
      <div class="container-x">
        <h2 class="display text-navy-900 text-2xl md:text-[2rem]">More videos</h2>
        <div class="mt-8 grid md:grid-cols-2 gap-8">
          {rest.map((v) => (
            <article>
              <YouTubeVideo video={v} />
              <h3 class="mt-4 font-display font-bold text-navy-900 text-lg">{v.title}</h3>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <CtaBand />
</BaseLayout>
