---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Backdrop from '@/components/Backdrop.astro';
import Scene from '@/components/Scene.astro';
import PhotoBg from '@/components/PhotoBg.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Icon from '@/components/Icon.astro';
import CtaBand from '@/components/CtaBand.astro';
import FaqAccordion from '@/components/FaqAccordion.astro';
import ContactForm from '@/components/ContactForm.astro';
import { serviceAreas, nearbyAreas } from '@/data/locations';
import { services } from '@/data/services';
import { business } from '@/data/business';
import { areaCopy, areaFaqs, areaTraitNote } from '@/lib/localize';
import { breadcrumbSchema, faqSchema, clampDescription, pickTitle } from '@/lib/seo';

export function getStaticPaths() {
  return serviceAreas.map((area) => ({
    params: { slug: area.slug },
    props: { area },
  }));
}

const { area } = Astro.props;
const copy = areaCopy(area);
const note = areaTraitNote(area);
// Alternate the two street photos so neighboring pages don't look identical.
const areaPhoto = (area.slug.charCodeAt(0) + area.slug.length) % 2 ? 'rowhouses' : 'street';
const near = nearbyAreas(area);
const isTier1 = area.tier === 1;

const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Service Areas', url: '/service-areas' },
  { name: area.name, url: `/service-areas/${area.slug}` },
];

const faqs = areaFaqs(area);

const title = pickTitle([
  `Locksmith in ${area.name}, ${area.region} | Nico & Vito Locksmith`,
  `Locksmith in ${area.name}, ${area.region} | Nico & Vito`,
  `${area.name} Locksmith, ${area.region} | Nico & Vito`,
  `Locksmith in ${area.name} | Nico & Vito Locksmith`,
  `${area.name} Locksmith | Nico & Vito`,
]);

const description = clampDescription(
  `Locksmith in ${area.name}, ${area.region} ${area.zip}. Lockouts, rekeys, car keys, intercoms & cameras. ${area.eta} from Bay Ridge, open daily 7AM–11PM. Call ${business.phone}.`
);

const schema = [
  breadcrumbSchema(crumbs),
  faqSchema(faqs),
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: `Locksmith services in ${area.name}`,
    description: copy.lead,
    serviceType: 'Locksmith',
    areaServed: {
      '@type': 'Place',
      name: `${area.name}, ${area.region}, NY ${area.zip}`,
      address: {
        '@type': 'PostalAddress',
        addressLocality: area.region,
        addressRegion: 'NY',
        postalCode: area.zip,
        addressCountry: 'US',
      },
    },
    provider: { '@id': 'https://nicovitolocksmith.com/#business' },
  },
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={`/service-areas/${area.slug}`}
  schema={schema}
>
  <!-- Header plate -->
  <section class="relative bg-navy-900 overflow-hidden">
    <PhotoBg variant={areaPhoto} strength={48} position="center 58%" eager />
    <Scene variant="bayridge" class="h-[58%]" opacity={0.11} />
    <div class="absolute left-0 inset-y-0 w-1 bg-brass-400 z-[1]" aria-hidden="true"></div>
    <span
      class="pointer-events-none select-none absolute -right-2 top-1/2 -translate-y-1/2 display text-white/[0.04] text-[7rem] lg:text-[11rem] leading-none whitespace-nowrap"
      aria-hidden="true">{area.zip}</span>

    <div class="container-x relative z-[1] py-11 md:py-14">
      <Breadcrumbs items={crumbs} light />
      <p class="mt-6 mb-4 font-display text-[0.7rem] font-bold uppercase tracking-[0.26em] text-brass-400">
        {area.region} · {area.zip}
      </p>
      <h1 class="display text-white text-[2.1rem] sm:text-[2.9rem] lg:text-[3.5rem] max-w-4xl leading-[1.04]">
        Locksmith in {area.name}
      </h1>
      <p class="mt-4 text-navy-200 text-lg max-w-2xl leading-relaxed">{copy.lead}</p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a href={`tel:${business.phoneHref}`} class="btn btn-brass" data-call-cta="area-hero">
          <Icon name="phone" size={18} />
          {business.phoneDisplay}
        </a>
        <a href="#quote" class="btn btn-ghost">Get a price</a>
      </div>
    </div>
  </section>

  <!-- Facts strip -->
  <section class="bg-navy-800 border-b border-white/10">
    <div class="container-x grid grid-cols-2 lg:grid-cols-4 divide-x divide-white/10">
      {[
        { k: 'Typical arrival', v: area.eta, i: 'bolt' },
        { k: 'Hours', v: 'Every day, 7am–11pm', i: 'clock' },
        { k: 'Borough', v: area.region, i: 'pin' },
        { k: 'Trip surcharge', v: 'None', i: 'dollar' },
      ].map((f) => (
        <div class="py-4 px-4 first:pl-0 last:pr-0">
          <p class="flex items-center gap-1.5 text-[0.65rem] uppercase tracking-[0.14em] text-navy-300">
            <Icon name={f.i} size={13} class="text-brass-400 shrink-0" />
            {f.k}
          </p>
          <p class="mt-1 text-white font-semibold text-[0.95rem]">{f.v}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Body -->
  <section class="relative overflow-hidden py-14 md:py-18 bg-cream">
    <Backdrop variant="bitting" tone="light" intensity={0.7} />
    <div class="container-x relative z-[1]">
      <div class="max-w-3xl prose-local text-[1.06rem]">
        <p class="text-navy-800 text-[1.15rem] leading-relaxed">{area.blurb}</p>
        <p>{copy.detail}</p>
        <p>{note}</p>
        <p>{copy.trust}{copy.coverage ? ` ${copy.coverage}` : ''}</p>
      </div>

      <h2 class="display text-navy-900 text-xl md:text-2xl pb-3 mt-12 mb-6 border-b-2 border-navy-900">
        {copy.heading}
      </h2>
      <ol class="grid sm:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-1">
        {services.map((s, i) => (
          <li class="border-b border-line">
            <a
              href={isTier1 ? `/services/${s.slug}/${area.slug}` : `/services/${s.slug}`}
              class="group flex items-baseline gap-3 py-3"
            >
              <span class="font-display font-bold text-[0.72rem] text-brass-500 tabular-nums">
                {String(i + 1).padStart(2, '0')}
              </span>
              <span class="text-navy-800 font-semibold text-[0.95rem] group-hover:text-brass-600 transition-colors">
                {s.short}{isTier1 ? ` in ${area.name}` : ''}
              </span>
              <Icon name="arrow" size={15} class="text-brass-500 ml-auto shrink-0 self-center opacity-0 group-hover:opacity-100 transition-opacity" />
            </a>
          </li>
        ))}
      </ol>

      <h2 class="display text-navy-900 text-xl md:text-2xl pb-3 mt-12 mb-5 border-b-2 border-navy-900">
        Streets and landmarks we cover
      </h2>
      <ul class="flex flex-wrap gap-2">
        {area.landmarks.map((l) => (
          <li class="inline-flex items-center gap-1.5 px-3 py-1.5 border border-line bg-white text-[0.87rem] text-navy-800">
            <Icon name="pin" size={13} class="text-brass-500" />
            {l}
          </li>
        ))}
      </ul>

      {near.length > 0 && (
        <>
          <h2 class="display text-navy-900 text-xl md:text-2xl pb-3 mt-12 mb-5 border-b-2 border-navy-900">
            Neighborhoods next door
          </h2>
          <ul class="flex flex-wrap gap-2">
            {near.map((n) => (
              <li>
                <a
                  href={`/service-areas/${n.slug}`}
                  class="inline-flex items-center gap-1.5 px-3 py-1.5 border border-line bg-white text-[0.87rem] text-navy-800 hover:bg-navy-900 hover:text-white hover:border-navy-900 transition-colors"
                >
                  <Icon name="pin" size={13} class="text-brass-500" />
                  {n.name}
                </a>
              </li>
            ))}
          </ul>
        </>
      )}
    </div>
  </section>

  <!-- Quote band -->
  <section class="relative overflow-hidden py-14 md:py-18 bg-navy-900" id="quote">
    <Backdrop variant="rings" tone="dark" />
    <div class="container-x relative z-[1] grid lg:grid-cols-12 gap-10 lg:gap-16 items-center">
      <div class="lg:col-span-5">
        <h2 class="display text-white text-2xl md:text-[2.1rem]">
          Get a price for {area.name}
        </h2>
        <p class="mt-4 text-navy-200 leading-relaxed">
          Describe the job and we'll quote it before we leave Bay Ridge — {area.eta} from you,
          any day between 7 AM and 11 PM.
        </p>
        <a href={`tel:${business.phoneHref}`} class="btn btn-brass mt-6" data-call-cta="area-band">
          <Icon name="phone" size={18} />
          {business.phoneDisplay}
        </a>
      </div>
      <div class="lg:col-span-7">
        <ContactForm variant="short" tone="dark" area={area.name} />
      </div>
    </div>
  </section>

  <FaqAccordion faqs={faqs} heading={`Locksmith in ${area.name} — questions we get`} />

  <CtaBand
    heading={`Need a locksmith in ${area.name}?`}
    body={`We're ${area.eta} away, open every day 7 AM to 11 PM. Call for a price before we head out.`}
  />
</BaseLayout>
