{
  "$schema": "node_modules/wrangler/config-schema.json",

  // Must match the existing Worker, or a deploy creates a second one and the
  // custom domain stays pointed at the old script.
  "name": "nicovitolock-astro",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",

  // Cloudflare's build for this project runs `npx wrangler deploy` with no
  // build step of its own, so without this dist/ does not exist at deploy
  // time and the assets.directory below fails to resolve. wrangler runs this
  // first. Do not remove it assuming the dashboard covers it — it does not.
  "build": { "command": "npm run build" },

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",

    // The Worker runs first on EVERY request, not just /api/*.
    //
    // Two reasons. /api/* must beat the asset router, which would otherwise
    // 301 POST /api/contact to /api/contact/ and drop the body. And the
    // canonical-host redirect in worker/index.js has to see page requests at
    // all — with assets served first, a GET for www/ never reached the Worker
    // and the redirect silently did nothing.
    //
    // Everything that is not handled explicitly falls through to
    // env.ASSETS.fetch(), which still applies _redirects and _headers.
    "run_worker_first": true
  },

  "observability": { "enabled": true }
}
